<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<!-- 전체 마스터리 목록 1행(무기 카드). 스타일은 MasteryScreen.uss 가 화면 루트에서 내려준다. -->
	<ui:VisualElement class="m-card m-weapon mastery-row">
		<ui:VisualElement class="m-weapon__frame"><ui:VisualElement name="icon" class="icon" /></ui:VisualElement>
		<ui:VisualElement class="m-weapon__body">
			<ui:VisualElement class="m-weapon__title-row">
				<ui:Label name="name" text="" class="m-weapon__name" />
				<ui:Label text="사용 중" class="m-weapon__active" />
				<ui:Label name="level" text="" class="m-weapon__level" />
			</ui:VisualElement>
			<ui:Label name="bonus" text="" class="m-weapon__bonus" />
			<ui:VisualElement class="m-gauge">
				<ui:VisualElement name="fill" class="m-gauge__fill" />
				<ui:Label name="gauge-text" text="" class="m-gauge__text" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
