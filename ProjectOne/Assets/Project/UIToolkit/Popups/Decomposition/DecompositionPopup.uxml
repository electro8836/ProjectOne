<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="Decomposition.uss" />

	<!-- 일괄 분해 — 등급 칩 6개(켜면 등급색 + 체크) · 품질(체크 + 보라 막대) · 자동 분해(스위치) · 분해. -->
	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head item-head">
				<ui:Label text="분해" class="popup__name item-head__name" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement class="decompose popup__body">
				<ui:Label text="분해할 등급" class="section-title" />
				<!-- 칩은 DecompositionPopup 이 만든다 -->
				<ui:VisualElement name="grades" class="decompose-grades" />

				<ui:Label text="품질" class="section-title" />
				<ui:VisualElement class="decompose-panel">
					<ui:Button name="quality-check" class="check decompose-check">
						<ui:VisualElement class="check__box" picking-mode="Ignore">
							<ui:VisualElement class="decompose-check__mark" picking-mode="Ignore" />
						</ui:VisualElement>
						<ui:Label name="quality-title" text="" class="check__label" picking-mode="Ignore" />
					</ui:Button>
					<ui:SliderInt name="quality-slider" fill="true" class="decompose-slider" />
				</ui:VisualElement>

				<ui:VisualElement class="decompose-panel decompose-auto">
					<ui:Label text="자동 분해" class="decompose-auto__name" />
					<ui:Label text="획득할 때 바로 분해" class="decompose-auto__hint" />
					<ui:Button name="auto-check" class="decompose-switch">
						<ui:VisualElement class="decompose-switch__knob" picking-mode="Ignore" />
					</ui:Button>
				</ui:VisualElement>
			</ui:VisualElement>

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="decompose" text="분해" class="btn btn--red popup__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
