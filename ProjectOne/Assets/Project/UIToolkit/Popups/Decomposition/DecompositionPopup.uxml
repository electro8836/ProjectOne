<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../Popups.uss" />
	<Style src="Decomposition.uss" />

	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label text="분해" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:Label text="분해할 등급" class="section-title popup__body" />
			<ui:VisualElement name="grades" class="px-inset decompose-grades popup__body" />

			<ui:Label text="품질" class="section-title popup__body" />
			<ui:VisualElement class="px-inset decompose-quality popup__body">
				<ui:Button name="quality-check" class="check">
					<ui:VisualElement class="check__box" picking-mode="Ignore" />
					<ui:Label name="quality-title" text="" class="check__label" picking-mode="Ignore" />
				</ui:Button>
				<ui:SliderInt name="quality-slider" class="px-slider" />
			</ui:VisualElement>

			<ui:VisualElement class="px-inset decompose-auto popup__body">
				<ui:Button name="auto-check" class="check">
					<ui:VisualElement class="check__box" picking-mode="Ignore" />
					<ui:Label text="자동 분해" class="check__label" picking-mode="Ignore" />
				</ui:Button>
			</ui:VisualElement>

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="decompose" text="분해" class="btn btn--red popup__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
