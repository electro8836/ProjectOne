<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="Ranking.uss" />

	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head item-head">
				<ui:Label text="전투력 랭킹" class="popup__name item-head__name" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
			<!-- 표 — 머리줄(순위·이름·전투력) + 줄무늬 목록. 시안 Shared/Design/UI랭킹목록_시안.png 4안 -->
			<ui:VisualElement class="px-inset rank-list-box popup__body">
				<ui:VisualElement class="rank-head" picking-mode="Ignore">
					<ui:Label text="순위" class="rank-head__label rank-head__rank" />
					<ui:Label text="이름" class="rank-head__label rank-head__name" />
					<ui:Label text="전투력" class="rank-head__label rank-head__power" />
				</ui:VisualElement>
				<ui:ScrollView name="list" class="rank-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
			</ui:VisualElement>
			<ui:Label text="내 순위" class="section-title popup__body" />
			<ui:VisualElement name="mine" class="rank-mine popup__body" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
