<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="CommonPopup.uss" />

	<!-- 공용 확인 팝업 — 제목 · 본문 · 버튼 1~2개. 버튼 1은 취소/단독 확인, 버튼 2는 진행(초록) -->
	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label name="title" text="" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement class="px-inset common-popup__desc-box">
				<ui:Label name="desc" text="" class="common-popup__desc" />
			</ui:VisualElement>

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="button-1" text="" class="btn popup__button" />
				<ui:Button name="button-2" text="" class="btn btn--green popup__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
