<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="CommonPopup.uss" />

	<!-- 공용 확인 팝업 — 제목 · 본문 · 버튼 1~2개. 버튼 1은 취소/단독 확인, 버튼 2는 진행(초록, 위험 확인은 빨강) -->
	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head item-head common-popup__head">
				<ui:Label name="title" text="" class="popup__name item-head__name" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement class="px-inset common-popup__desc-box">
				<ui:Label name="desc" text="" class="common-popup__desc" />
			</ui:VisualElement>

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="button-1" text="" class="btn popup__button" />
				<ui:Button name="button-2" text="" class="btn popup__button common-popup__confirm" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
