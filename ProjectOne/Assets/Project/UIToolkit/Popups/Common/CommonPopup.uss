/* 공용 확인 팝업 — 틀(.popup·.popup__window·.popup__head·.popup__buttons)은 Theme.uss 를 따른다. */

.common-popup__desc-box {
	min-height: 220px;
	margin: 0 40px 30px 40px;
	padding: 30px 32px;
	justify-content: center;
}

.common-popup__desc {
	font-size: 48px;
	white-space: normal;
	-unity-text-align: middle-center;
}
