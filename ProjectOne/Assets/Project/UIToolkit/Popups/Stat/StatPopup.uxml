<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="StatPopup.uss" />

	<!-- 내 능력치 — 공격 · 방어 · 기타 묶음마다 틀 하나(맨 위 묶음 색 머리띠), 안은 2열 칸(위 이름 · 아래 값) -->
	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head item-head">
				<ui:Label text="능력치" class="popup__name item-head__name" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
			<ui:ScrollView name="scroll" class="stat-scroll popup__body" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
				<ui:VisualElement class="stat-group stat-group--offensive">
					<ui:VisualElement class="stat-group__head">
						<ui:VisualElement class="stat-group__icon" />
						<ui:Label text="공격" class="stat-group__title" />
					</ui:VisualElement>
					<ui:VisualElement name="offensive" class="stat-grid" />
				</ui:VisualElement>
				<ui:VisualElement class="stat-group stat-group--defensive">
					<ui:VisualElement class="stat-group__head">
						<ui:VisualElement class="stat-group__icon" />
						<ui:Label text="방어" class="stat-group__title" />
					</ui:VisualElement>
					<ui:VisualElement name="defensive" class="stat-grid" />
				</ui:VisualElement>
				<ui:VisualElement class="stat-group stat-group--utility">
					<ui:VisualElement class="stat-group__head">
						<ui:VisualElement class="stat-group__icon" />
						<ui:Label text="기타" class="stat-group__title" />
					</ui:VisualElement>
					<ui:VisualElement name="utility" class="stat-grid" />
				</ui:VisualElement>
			</ui:ScrollView>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
