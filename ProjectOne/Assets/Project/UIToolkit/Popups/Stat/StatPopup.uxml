<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../Popups.uss" />
	<Style src="StatPopup.uss" />

	<!-- 내 능력치 — 공격 · 방어 · 기타 세 묶음 -->
	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label text="능력치" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
			<ui:ScrollView name="scroll" class="stat-scroll popup__body" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
				<ui:Label text="공격" class="section-title" />
				<ui:VisualElement name="offensive" class="px-inset stat-group" />
				<ui:Label text="방어" class="section-title" />
				<ui:VisualElement name="defensive" class="px-inset stat-group" />
				<ui:Label text="기타" class="section-title" />
				<ui:VisualElement name="utility" class="px-inset stat-group" />
			</ui:ScrollView>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
