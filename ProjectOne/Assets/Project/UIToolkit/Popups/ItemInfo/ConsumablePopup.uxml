<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="ItemInfo.uss" />

	<!-- 소모품 정보 — 장비 정보와 같은 등급색 제목 줄 · 칸 + 보유 수 · 사용 효과 판 · 아래 조작 띠(수량 -/+ · 사용).
	     삭제는 요약 줄 오른쪽 위 작은 버튼. 시안 Shared/Design/UI소모품정보_시안.png 4안 -->
	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<!-- 판·선·등급 박스 색은 등급에 따라 ConsumableInfoPopup 이 칠한다 -->
			<ui:VisualElement name="head" class="px-wood popup__head item-head">
				<ui:Label name="name" text="" class="popup__name item-head__name" />
				<ui:Label name="grade" text="" class="item-head__grade" picking-mode="Ignore" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
			<ui:VisualElement class="item-summary popup__body">
				<ui:VisualElement name="cell" class="item-summary__cell" />
				<ui:VisualElement class="item-summary__meta">
					<ui:Label name="owned" text="" class="consumable-owned" />
				</ui:VisualElement>
				<ui:VisualElement class="item-summary__actions">
					<ui:Button name="delete" text="삭제" class="btn btn--red btn--small" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:VisualElement class="popup__body">
				<ui:Label text="사용 효과" class="section-title" />
				<ui:Label name="desc" text="" class="popup-text equip-info-desc" />
			</ui:VisualElement>
			<!-- 수량 조절 + 사용 (읽기 전용이면 감춘다) -->
			<ui:VisualElement name="control" class="consumable-bar popup__body">
				<ui:Button name="minus" text="" class="consumable-step">
					<ui:VisualElement class="consumable-step__face" picking-mode="Ignore">
						<ui:VisualElement class="consumable-step__icon consumable-step__icon--minus" picking-mode="Ignore" />
					</ui:VisualElement>
				</ui:Button>
				<ui:Label name="count" text="1" class="consumable-bar__count" />
				<ui:Button name="plus" text="" class="consumable-step">
					<ui:VisualElement class="consumable-step__face" picking-mode="Ignore">
						<ui:VisualElement class="consumable-step__icon consumable-step__icon--plus" picking-mode="Ignore" />
					</ui:VisualElement>
				</ui:Button>
				<ui:Button name="use" text="사용" class="btn btn--green popup__button consumable-bar__use" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
