/* 아이템 정보 팝업(장비·소모품) 공용 */

.item-summary {
	flex-direction: row;
	align-items: center;
	margin-bottom: 24px;
}

.item-summary__cell {
	width: 192px;
	height: 192px;
}

.item-summary__cell .item-cell {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.item-summary__meta {
	flex-grow: 1;
	margin-left: 30px;
}

.item-summary__grade {
	font-size: 48px;
}

.item-summary__sub {
	font-size: 36px;
	color: var(--ink-sub);
}

/* 잠금(위) + 분해(아래) — 요약 줄 오른쪽 위에 붙인다 */
.item-summary__actions {
	align-self: flex-start;
	align-items: stretch;
}

.item-summary__actions .btn {
	margin-bottom: 12px;
}

/* 소모품 수량 조절 */
.consumable-control {
	padding-bottom: 6px;
}

.consumable-count {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	margin-bottom: 20px;
}

.consumable-count .btn {
	font-size: 60px;
}

.consumable-count__value {
	width: 200px;
	font-size: 60px;
	-unity-text-align: middle-center;
}

/* 장비 정보 — 설명·옵션이 한 덩어리로 스크롤된다. 높이는 고정이라 팝업 전체 크기가 장비마다 같고, 넘치는 내용은 스크롤로 본다 */
.equip-info-scroll {
	height: 720px;
	flex-shrink: 0;
	margin-bottom: 24px;
}

.equip-info-desc {
	color: var(--ink-sub);
	margin-bottom: 14px;
}

.option-box {
	padding: 16px 20px;
	margin-bottom: 16px;
}

.option-line {
	flex-direction: row;
	align-items: center;
	padding: 4px 0;
}

.option-line__icon {
	width: 48px;
	height: 48px;
	margin-right: 12px;
	-unity-background-scale-mode: scale-to-fit;
}

.option-line__mark {
	width: 28px;
	height: 28px;
	margin-right: 14px;
	border-width: 4px;
}

.option-line__text {
	flex-grow: 1;
	flex-shrink: 1;
	font-size: 36px;
	white-space: normal;
}

.option-line__range {
	font-size: 36px;
	color: var(--ink-sub);
	margin-left: 10px;
}

/* 보관함 이동 — 창 아래 28px 띄워 가운데에. 장착·강화(112px · 48px 글자)보다 작게 88px · 36px 글자.
   가운데 정렬은 왼쪽 여백(-폭/2)으로 한다 — translate 로 하면 누를 때의 눌림 연출(.btn:active translate)이 덮어써 옆으로 튄다 */
.equip-info-stash {
	position: absolute;
	top: 100%;
	left: 50%;
	margin-left: -220px;
	width: 440px;
	height: 88px;
	margin-top: 28px;
	font-size: 36px;
}

/* 보관 버튼이 보일 때 — 창 + 버튼 덩어리가 화면 가운데에 오도록 아래 여백(28 + 88)을 잡아 창을 올린다 */
.popup__window--stash {
	margin-bottom: 116px;
}
