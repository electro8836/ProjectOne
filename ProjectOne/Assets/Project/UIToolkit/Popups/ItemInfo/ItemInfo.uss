/* 아이템 정보 팝업(장비·소모품) 공용 */

.item-summary {
	flex-direction: row;
	align-items: center;
	margin-bottom: 24px;
}

.item-summary__cell {
	width: 192px;
	height: 192px;
}

.item-summary__cell .item-cell {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.item-summary__meta {
	flex-grow: 1;
	margin-left: 30px;
}

.item-summary__sub {
	font-size: 36px;
	color: var(--ink-sub);
}

/* 잠금(위) + 분해(아래) — 요약 줄 오른쪽 위에 붙인다 */
.item-summary__actions {
	align-self: flex-start;
	align-items: stretch;
}

.item-summary__actions .btn {
	margin-bottom: 12px;
}

/* ── 소모품 — 보유 수 · 아래 조작 띠(수량 -/+ · 사용). 시안 Shared/Design/UI소모품정보_시안.png 4안 ── */
.consumable-owned {
	margin: 0;
	padding: 0;
	font-size: 44px;
	color: #FFFFFF;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;	/* :root 의 2px 외곽선을 끈다 — 그림자로 대신한다 */
	text-shadow: 0 4px 0 #0A0814;
}

/* 조작 띠 — 설명 판과 같은 어두운 판에 [-] 수량 [+] [사용] 한 줄 */
.consumable-bar {
	flex-direction: row;
	align-items: center;
	padding: 16px 16px 16px 24px;
	margin-bottom: 6px;
	border-radius: 18px;
	background-color: #26272C;
}

/* -/+ — 미니맵 확대·축소 버튼과 같은 꾸밈(금 테 · 검은 면 · 연보라 기호), 크기만 키운다 */
.consumable-step {
	margin: 0;
	padding: 6px;
	width: 96px;
	height: 96px;
	flex-shrink: 0;
	border-width: 5px;
	border-radius: 48px;
	border-color: #0A0814;
	background-image: none;
	background-color: #B8964A;
}

.consumable-step:hover:enabled {
	background-color: #B8964A;
	border-color: #0A0814;
}

.consumable-step:active {
	translate: 0 4px;
}

/* 기본 버튼의 비활성 반투명(opacity)을 끄고 색으로만 구분한다 */
.consumable-step:disabled {
	opacity: 1;
	background-color: #545868;
}

.consumable-step__face {
	flex-grow: 1;
	border-radius: 37px;
	background-color: #18171C;
	align-items: center;
	justify-content: center;
}

.consumable-step:disabled .consumable-step__face {
	background-color: #3A3D4A;
}

/* Icon_Plus / Icon_Minus(44x47) — 버튼 지름의 60% 높이 */
.consumable-step__icon {
	width: 54px;
	height: 58px;
	-unity-background-scale-mode: scale-to-fit;
}

.consumable-step__icon--plus {
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Symbols/Icon_Plus.png");
}

.consumable-step__icon--minus {
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Symbols/Icon_Minus.png");
}

/* 연보라 채움이 회색이 되도록 어둡게 곱한다 */
.consumable-step:disabled .consumable-step__icon {
	-unity-background-image-tint-color: #8A8796;
}

.consumable-bar__count {
	width: 120px;
	margin: 0;
	padding: 0;
	font-size: 56px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 4px 0 #0A0814;
}

.consumable-bar__use {
	flex-grow: 1;
	margin: 0 0 0 28px;
}

/* 장비 정보 — 설명·옵션이 한 덩어리로 스크롤된다. 높이는 고정이라 팝업 전체 크기가 장비마다 같고, 넘치는 내용은 스크롤로 본다 */
.equip-info-scroll {
	height: 720px;
	flex-shrink: 0;
	margin-bottom: 24px;
}

.equip-info-desc {
	color: var(--ink-sub);
	margin-bottom: 14px;
}

.option-box {
	padding: 16px 20px;
	margin-bottom: 16px;
}

.option-line {
	flex-direction: row;
	align-items: center;
	padding: 4px 0;
}

.option-line__icon {
	width: 48px;
	height: 48px;
	margin-right: 12px;
	-unity-background-scale-mode: scale-to-fit;
}

.option-line__mark {
	width: 28px;
	height: 28px;
	margin-right: 14px;
	border-width: 4px;
}

.option-line__text {
	flex-grow: 1;
	flex-shrink: 1;
	font-size: 36px;
	white-space: normal;
}

.option-line__range {
	font-size: 36px;
	color: var(--ink-sub);
	margin-left: 10px;
}

/* 보관함 이동 — 창 아래 28px 띄워 가운데에. 장착·강화(112px · 48px 글자)보다 작게 88px · 36px 글자.
   가운데 정렬은 왼쪽 여백(-폭/2)으로 한다 — translate 로 하면 누를 때의 눌림 연출(.btn:active translate)이 덮어써 옆으로 튄다 */
.equip-info-stash {
	position: absolute;
	top: 100%;
	left: 50%;
	margin-left: -220px;
	width: 440px;
	height: 88px;
	margin-top: 28px;
	font-size: 36px;
}

/* 보관 버튼이 보일 때 — 창 + 버튼 덩어리가 화면 가운데에 오도록 아래 여백(28 + 88)을 잡아 창을 올린다 */
.popup__window--stash {
	margin-bottom: 116px;
}

/* ── 재료 아이템 정보(제작 화면) — 칸 옆 설명 + 획득처 | 사용처 탭 ── */

/* 보유 수 자리에 들어가는 설명 */
.material-side-desc {
	margin: 0;
	padding: 0;
	font-size: 30px;
	color: #E6E6EE;
	white-space: normal;
}

.material-tabs {
	flex-direction: row;
	height: 80px;
	padding: 6px;
	margin-bottom: 22px;
	border-radius: 20px;
	background-color: #26272C;
}

.material-tab {
	flex-grow: 1;
	flex-basis: 0;
	margin: 0;
	padding: 0;
	border-width: 0;
	border-radius: 16px;
	background-color: rgba(0, 0, 0, 0);
	background-image: none;
	font-size: 32px;
	color: #AAACB6;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
}

.material-tab--on {
	background-color: #545866;
	color: #FFFFFF;
	text-shadow: 0 2px 0 #0A0814;
}

/* 높이 고정 — 개수가 늘어도 팝업 크기는 그대로, 목록만 스크롤한다 */
.material-scroll {
	height: 720px;
	flex-shrink: 0;
}

.material-empty {
	margin-top: 24px;
	font-size: 28px;
	color: #AAACB6;
	-unity-text-align: middle-center;
}

/* 획득처 — 칩 + 문구. 처치는 보스마다 한 줄이고 칩은 첫 줄에만(이어지는 줄은 자리만 지켜 이름 열을 맞춘다) */
.material-source {
	flex-direction: row;
	align-items: center;
	min-height: 54px;
	margin-top: 20px;
}

.material-source--first {
	margin-top: 4px;
}

.material-source--cont {
	margin-top: 0;
	min-height: 46px;
}

.material-source--cont .material-source__chip {
	visibility: hidden;
}

.material-source__chip {
	padding: 4px 14px;
	margin-right: 22px;
	border-radius: 12px;
	font-size: 26px;
	color: #FFFFFF;
	flex-shrink: 0;
}

.material-source__chip--boss {
	background-color: #D8404A;
}

.material-source__chip--combine {
	background-color: #8A5CE0;
}

.material-source__chip--decompose {
	background-color: #24A8A0;
}

.material-source__text {
	flex-grow: 1;
	flex-shrink: 1;
	margin: 0;
	padding: 0;
	font-size: 28px;
	color: #E6E6EE;
	white-space: normal;
}

/* 조합하기 — 작은 초록 버튼(켜진 버튼 면) */
.theme-violet .btn.material-source__combine {
	margin-left: 12px;
	height: 60px;
	min-width: 0;
	padding: 0 22px;
	flex-shrink: 0;
	background-image: url("../../Violet/btn_active.png");
	-unity-slice-left: 30;
	-unity-slice-right: 30;
	font-size: 26px;
	color: #FFFFFF;
}

/* 사용처 — 결과 칸 + 이름 + 필요 수 + 화살표. 줄을 누르면 그 제작법으로 간다 */
.material-use {
	flex-direction: row;
	align-items: center;
	height: 104px;
	padding: 0 8px 0 0;
	margin-bottom: 8px;
	border-radius: 16px;
}

.material-use:active {
	background-color: #3A3C44;
}

.material-use__cell {
	width: 92px;
	height: 92px;
	flex-shrink: 0;
}

.material-use__cell .item-cell {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.material-use__cell .item-cell__tier {
	top: -10px;
	padding: 0 8px 1px 8px;
	border-width: 2px;
	font-size: 18px;
}

.material-use__name {
	flex-grow: 1;
	flex-shrink: 1;
	margin: 0 0 0 20px;
	padding: 0;
	font-size: 30px;
	color: #FFFFFF;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 2px 0 #0A0814;
}

.material-use__count {
	margin: 0 0 0 12px;
	padding: 0;
	font-size: 28px;
	color: #AAACB6;
}

.material-use__arrow {
	width: 20px;
	height: 30px;
	margin-left: 16px;
	background-image: url("../../Violet/icon_chevron.png");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: #AAACB6;
}
