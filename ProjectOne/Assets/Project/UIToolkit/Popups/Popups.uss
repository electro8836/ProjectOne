/* 팝업 공용 내용 조각 — 틀(.popup·.popup__window·.popup__head·.popup__buttons)은 Theme.uss, 팝업별 배치는 각 팝업 USS. */

/* 창 안쪽 본문 여백 */
.popup__body {
	margin: 0 40px;
}

/* 아이템 칸 격자 (보상 목록 등) */
/* 본문 최소 높이 — 공용 확인 팝업 본문(360)과 같게. 칸이 적어도 팝업이 납작해지지 않고, 칸 줄은 세로 가운데에 모은다 */
.popup-grid {
	min-height: 360px;
	max-height: 900px;
}

.popup-grid .unity-scroll-view__content-viewport {
	justify-content: center;
}

.popup-grid .unity-scroll-view__content-container {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
}

.popup-grid .item-cell {
	width: 168px;
	height: 168px;
	margin: 8px;
}

/* 본문 상자 + 글 */
.popup-text-box {
	margin: 0 40px 26px 40px;
	padding: 28px 32px;
}

.popup-text {
	font-size: 36px;
	white-space: normal;
}

.popup-hint {
	margin: 0 40px 20px 40px;
	font-size: 36px;
	color: var(--ink-sub);
	white-space: normal;
	-unity-text-align: middle-center;
}
