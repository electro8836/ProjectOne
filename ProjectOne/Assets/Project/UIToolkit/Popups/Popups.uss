/* 팝업 공용 내용 조각 — 틀(.popup·.popup__window·.popup__head·.popup__buttons)은 Theme.uss, 팝업별 배치는 각 팝업 USS. */

/* 창 안쪽 본문 여백 */
.popup__body {
	margin: 0 40px;
}

/* 본문 상자 + 글 */
.popup-text-box {
	margin: 0 40px 26px 40px;
	padding: 28px 32px;
}

.popup-text {
	font-size: 36px;
	white-space: normal;
}

.popup-hint {
	margin: 0 40px 20px 40px;
	font-size: 36px;
	color: var(--ink-sub);
	white-space: normal;
	-unity-text-align: middle-center;
}
