<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../Popups.uss" />
	<Style src="PetEnhance.uss" />

	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label name="pet-name" text="" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement class="pet-top popup__body">
				<ui:VisualElement name="stage" class="pet-stage">
					<ui:VisualElement name="pet-image" class="pet-stage__image" picking-mode="Ignore" />
					<ui:Label name="equip-stat" text="장착중" class="pet-stage__equipped" picking-mode="Ignore" style="display: none;" />
				</ui:VisualElement>
				<ui:VisualElement class="pet-info">
					<ui:Label name="level" text="" class="pet-info__line" />
					<ui:Label name="grade" text="" class="pet-info__line" />
					<ui:Button name="equip" text="장착" class="btn btn--small pet-info__equip" />
				</ui:VisualElement>
			</ui:VisualElement>

			<ui:VisualElement class="px-inset popup-text-box">
				<ui:Label name="bonus" text="" class="popup-text" />
				<ui:Label name="equip-text" text="" class="popup-text pet-equip-text" />
			</ui:VisualElement>

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="level-up" text="" class="btn btn--green popup__button pet-cost">
					<ui:Label text="강화" class="pet-cost__label" picking-mode="Ignore" />
					<ui:VisualElement class="pet-cost__row" picking-mode="Ignore">
						<ui:VisualElement class="pet-cost__icon" picking-mode="Ignore" />
						<ui:Label text="" class="pet-cost__amount" picking-mode="Ignore" />
					</ui:VisualElement>
				</ui:Button>
				<ui:Button name="grade-up" text="" class="btn btn--purple popup__button pet-cost">
					<ui:Label text="등급업" class="pet-cost__label" picking-mode="Ignore" />
					<ui:VisualElement class="pet-cost__row" picking-mode="Ignore">
						<ui:VisualElement class="pet-cost__icon" picking-mode="Ignore" />
						<ui:Label text="" class="pet-cost__amount" picking-mode="Ignore" />
					</ui:VisualElement>
				</ui:Button>
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
