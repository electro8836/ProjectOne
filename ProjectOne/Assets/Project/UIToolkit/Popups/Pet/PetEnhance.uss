/* 펫 강화 팝업 */

.pet-top {
	flex-direction: row;
	align-items: center;
	margin-bottom: 20px;
}

/* 바탕은 등급 bg, 틀은 등급 border 로 View 가 칠한다 */
.pet-stage {
	width: 300px;
	height: 300px;
	align-items: center;
	justify-content: center;
	background-image: url("../../Pixel/slot_empty.png");
	-unity-slice-left: 6;
	-unity-slice-right: 6;
	-unity-slice-top: 6;
	-unity-slice-bottom: 6;
	-unity-slice-scale: 4px;
}

.pet-stage__image {
	width: 240px;
	height: 240px;
	-unity-background-scale-mode: scale-to-fit;
}

.pet-stage__equipped {
	position: absolute;
	right: 10px;
	top: 10px;
	padding: 2px 10px 6px 10px;
	font-size: 36px;
	color: var(--white);
	background-image: url("../../Pixel/chip_green.png");
	-unity-slice-left: 3;
	-unity-slice-right: 3;
	-unity-slice-top: 3;
	-unity-slice-bottom: 3;
	-unity-slice-scale: 4px;
	-unity-text-outline-color: var(--ink);
}

.pet-info {
	flex-grow: 1;
	margin-left: 30px;
}

.pet-info__line {
	font-size: 36px;
	margin-bottom: 8px;
	white-space: normal;
}

.pet-info__equip {
	align-self: flex-start;
	margin-top: 10px;
}

.pet-equip-text {
	margin-top: 12px;
	color: var(--gold);
}

.pet-cost {
	flex-direction: column;
	padding-top: 6px;
}

.pet-cost__label {
	font-size: 48px;
	color: var(--white);
	-unity-text-outline-color: var(--ink);
}

.pet-cost__row {
	flex-direction: row;
	align-items: center;
}

.pet-cost__icon {
	width: 40px;
	height: 40px;
	margin-right: 6px;
	-unity-background-scale-mode: scale-to-fit;
}

.pet-cost__amount {
	font-size: 36px;
	color: var(--white);
	-unity-text-outline-color: var(--ink);
}
