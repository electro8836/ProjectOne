/* 재화 목록 팝업 — 보라 아이템 칸 4열 + 아래띠 보유량. */

.currency-box {
	height: 660px;
	margin-top: 26px;
	margin-bottom: 30px;
	padding: 12px;
	border-radius: 18px;
	background-image: none;
	background-color: #26272C;
}

.currency-grid {
	flex-grow: 1;
}

/* 4열 — 칸 196 + 좌우 8 여백(가장자리 여백은 음수 여백으로 상쇄) */
.currency-grid .unity-scroll-view__content-container {
	flex-direction: row;
	flex-wrap: wrap;
	margin: 0 -8px;
}

.currency-cell {
	width: 196px;
	height: 196px;
	margin: 0 8px 16px 8px;
}

/* 아이콘 — 아래띠 자리를 남기고 가운데 */
.currency-cell .item-cell__icon {
	left: 30px;
	right: 30px;
	top: 20px;
	bottom: 60px;
}

/* 보유량 — 칸 바탕(틀 안쪽 11/10/15px) 아래쪽 어두운 띠, 가운데 */
.currency-cell .item-cell__count {
	left: 11px;
	right: 11px;
	bottom: 15px;
	height: 46px;
	padding: 0;
	border-radius: 0;
	border-bottom-left-radius: 12px;
	border-bottom-right-radius: 12px;
	background-color: rgba(10, 8, 20, 0.75);
	-unity-text-align: middle-center;
	font-size: 34px;
}
