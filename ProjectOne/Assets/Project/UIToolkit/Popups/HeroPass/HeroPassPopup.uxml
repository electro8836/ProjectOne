<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="HeroPass.uss" />

	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head item-head">
				<ui:Label text="히어로 패스" class="popup__name item-head__name" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement name="header" class="px-inset pass-header popup__body">
				<ui:VisualElement class="pass-header__level-box">
					<ui:Label text="Lv" class="pass-header__level-caption" />
					<ui:Label name="level" text="" class="pass-header__level" />
				</ui:VisualElement>
				<ui:VisualElement class="pass-header__info">
					<ui:Label name="state" text="" class="pass-header__state" />
					<ui:VisualElement class="gauge gauge--gold">
						<ui:VisualElement name="progress-fill" class="gauge__fill" />
						<ui:Label name="progress-text" text="" class="gauge__text" />
					</ui:VisualElement>
					<ui:Label name="remain" text="" class="pass-header__remain" />
				</ui:VisualElement>
			</ui:VisualElement>

			<!-- 열 제목 일반 / 패스 머리판. 스크롤 안 됨. 미구매면 columns 에 잠금 클래스(HeroPassPopup.SetHeader) -->
			<ui:VisualElement name="columns" class="pass-columns popup__body" picking-mode="Ignore">
				<ui:VisualElement class="pass-columns__half">
					<ui:VisualElement class="pass-plate pass-plate--normal">
						<ui:VisualElement class="pass-plate__hi" />
						<ui:Label text="일반" class="pass-plate__text" />
					</ui:VisualElement>
				</ui:VisualElement>
				<ui:VisualElement class="pass-columns__middle" />
				<ui:VisualElement class="pass-columns__half">
					<ui:VisualElement class="pass-plate pass-plate--pass">
						<ui:VisualElement class="pass-plate__hi" />
						<ui:Label text="패스" class="pass-plate__text" />
					</ui:VisualElement>
				</ui:VisualElement>
			</ui:VisualElement>

			<!-- 보상 목록 영역 배경(pass-board)과 줄은 코드가 스크롤 내용 안에 만든다. 안내와 스크롤 막대는 목록 위에 고정 -->
			<ui:VisualElement class="pass-list-wrap popup__body">
				<ui:ScrollView name="list" class="pass-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
				<ui:VisualElement name="scroll-thumb" class="pass-scroll-thumb" picking-mode="Ignore" />
				<ui:VisualElement name="guide" class="pass-guide" picking-mode="Ignore">
					<ui:Label text="구매하고 받기" class="pass-guide__text" />
				</ui:VisualElement>
			</ui:VisualElement>

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="all-receive" text="모두 받기" class="btn btn--green popup__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
