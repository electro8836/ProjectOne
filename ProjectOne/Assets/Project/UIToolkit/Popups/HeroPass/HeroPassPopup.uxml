<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../Popups.uss" />
	<Style src="HeroPass.uss" />

	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label text="히어로 패스" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement name="header" class="px-inset pass-header popup__body">
				<ui:VisualElement class="pass-header__level-box">
					<ui:Label text="Lv" class="pass-header__level-caption" />
					<ui:Label name="level" text="" class="pass-header__level" />
				</ui:VisualElement>
				<ui:VisualElement class="pass-header__info">
					<ui:Label name="state" text="" class="pass-header__state" />
					<ui:VisualElement class="gauge gauge--gold">
						<ui:VisualElement name="progress-fill" class="gauge__fill" />
						<ui:Label name="progress-text" text="" class="gauge__text" />
					</ui:VisualElement>
					<ui:Label name="remain" text="" class="pass-header__remain" />
				</ui:VisualElement>
			</ui:VisualElement>

			<ui:VisualElement class="pass-columns popup__body">
				<ui:Label text="일반" class="pass-columns__label" />
				<ui:Label text="레벨" class="pass-columns__label pass-columns__label--middle" />
				<ui:Label text="패스" class="pass-columns__label" />
			</ui:VisualElement>
			<ui:ScrollView name="list" class="pass-list popup__body" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />

			<ui:VisualElement class="popup__buttons">
				<ui:Button name="all-receive" text="모두 받기" class="btn btn--green popup__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
