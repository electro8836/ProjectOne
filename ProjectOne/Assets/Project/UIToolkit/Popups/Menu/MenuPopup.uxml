<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../Popups.uss" />

	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label text="메뉴" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
			<ui:VisualElement class="popup__body">
				<ui:Button name="setting" text="설정" class="btn popup-menu__button" />
				<ui:Button name="account" text="계정" class="btn popup-menu__button" />
				<ui:Button name="mail" text="우편함" class="btn popup-menu__button"><ui:VisualElement name="mail-badge" class="badge" picking-mode="Ignore" /></ui:Button>
				<ui:Button name="afk" text="방치 모드" class="btn popup-menu__button" />
				<ui:Button name="quit" text="게임 종료" class="btn btn--red popup-menu__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
