/* 획득 보상 — 틀 없이 어두운 덮개 + 크림색 제목 + 금선 + 5열 칸(왼쪽부터 채움) + 아래 '화면을 터치하여 닫기'.
   시안: Shared/Design/UI보상팝업_참고방향_시안.png A안 */

/* 덮개 — 뒤 화면이 희미하게만 비칠 만큼 짙게. 리니어 색 공간이라 불투명도가 수치보다 훨씬 옅게 보여서
   0.92 는 절반쯤 비치고, 0.997 이어야 참고 이미지 정도로 어둡다(플레이에서 맞춘 값) */
.reward.popup--open .popup__dim {
	background-color: rgba(8, 6, 20, 0.997);
}

/* 제목부터 닫기 글자 바로 위까지 — 칸이 넘치면 이 안에서 잘리고 스크롤된다 */
.reward__body {
	position: absolute;
	left: 0;
	right: 0;
	top: 400px;
	bottom: 380px;
	align-items: center;
	opacity: 0;
	scale: 0.92;
	transition-property: opacity, scale;
	transition-duration: 0.18s;
	transition-timing-function: ease-out-back;
}

.popup--open .reward__body {
	opacity: 1;
	scale: 1;
}

.reward__title {
	margin: 0;
	padding: 0;
	font-size: 60px;
	color: #FFE4A4;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 4px 0 #0A0814;
}

.reward__line {
	width: 760px;
	height: 4px;
	margin: 16px 0 28px 0;
	background-image: url("../../Violet/reward_line.png");
	-unity-background-scale-mode: stretch-to-fill;
}

/* 칸 184px 간격 5열 — 남은 높이를 다 쓰고, 넘치면 스크롤 */
.reward__grid {
	width: 920px;
	flex-shrink: 1;
	min-height: 0;
}

.reward__grid .unity-scroll-view__content-container {
	flex-direction: row;
	flex-wrap: wrap;
}

.reward__grid .item-cell {
	width: 168px;
	height: 168px;
	margin: 8px;
}

/* 수량 — 칸 오른쪽 아래에 어두운 배지 없이 숫자만(외곽선·그림자로 읽힌다) */
.theme-violet .reward__grid .item-cell__count {
	right: 16px;
	bottom: 18px;
	padding: 0;
	background-color: rgba(0, 0, 0, 0);
	-unity-text-outline-width: 3px;
	-unity-text-outline-color: #0A0814;
}

.reward__hint {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 300px;
	margin: 0;
	padding: 0;
	font-size: 40px;
	color: #ECE8FA;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 3px 0 #0A0814;
}
