/* 출석 팝업 — 달력 판: 어두운 판에 칸을 2px 틈으로 붙여 깐다. 주간 4열(큰 칸), 월간 6열(작은 칸). */

/* 탭이 창 위에 붙도록 창과 탭을 한 묶음으로 띄운다 — 등장 전환은 이 묶음에 건다 */
.daily-window {
	width: 960px;
	opacity: 0;
	scale: 0.85;
	translate: 0 40px;
	transition-property: opacity, scale, translate;
	transition-duration: 0.15s;
	transition-timing-function: ease-out-back;
}

.popup--open .daily-window {
	opacity: 1;
	scale: 1;
	translate: 0 0;
}

/* 묶음이 전환을 맡으므로 안쪽 창은 바로 보인다 */
.daily-frame {
	width: 100%;
	opacity: 1;
	scale: 1;
	translate: 0 0;
}

.daily-tabs {
	padding: 0 20px;
}

/* 판 — 너비는 칸 수에 맞춘다(주간 4 x (210 + 2) + 안쪽 22, 월간 6 x (138 + 2) + 22) */
.daily-grid {
	flex-direction: row;
	flex-wrap: wrap;
	align-self: center;
	width: 870px;
	padding: 11px;
	margin-bottom: 30px;
	border-radius: 18px;
	background-color: #26272C;
}

.daily-grid--month {
	width: 862px;
}

/* 칸 — 지난 날(받음)은 어둡게, 오늘은 보라 칸 + 보라 테두리, 오늘 받은 뒤는 초록 테두리 */
.daily-cell {
	width: 210px;
	height: 216px;
	margin: 1px;
	align-items: center;
	justify-content: center;
	background-color: #3A3C43;
}

.daily-cell--claimed {
	background-color: #282A30;
}

.daily-cell--focus {
	border-width: 4px;
	border-color: #A893FF;
	background-color: #423A68;
}

.daily-cell--focus.daily-cell--claimed {
	border-color: #38AA64;
}

.daily-cell__day,
.daily-cell__count {
	margin: 0;
	padding: 0;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;	/* :root 의 2px 외곽선을 끈다 — 그림자로 대신한다 */
	text-shadow: 0 3px 0 #0A0814;
}

/* 날짜 — 왼쪽 위, 연보라 */
.daily-cell__day {
	position: absolute;
	top: 10px;
	left: 14px;
	font-size: 32px;
	color: #C8B8FF;
}

.daily-cell--claimed .daily-cell__day {
	color: #786E99;
}

/* 아이콘 — 아래 수량 자리만큼 위로 */
.daily-cell__icon {
	width: 104px;
	height: 104px;
	margin-bottom: 16px;
	-unity-background-scale-mode: scale-to-fit;
}

.daily-cell--claimed .daily-cell__icon {
	opacity: 0.35;
}

/* 수량 — 아래 가운데 */
.daily-cell__count {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 22px;
	height: 40px;
	font-size: 32px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
}

.daily-cell--claimed .daily-cell__count {
	color: #787A84;
}

/* 이름은 칸에 비해 길다 — 감추고, 칸을 누르면 툴팁으로 보인다 */
.daily-cell__name {
	display: none;
}

/* 받음 체크 — 아이콘 위에 얹는다 */
.daily-cell__check {
	position: absolute;
	left: 58px;
	right: 58px;
	top: 56px;
	bottom: 72px;
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Symbols/Icon_Check.png");
	-unity-background-scale-mode: scale-to-fit;
	opacity: 0.8;
	display: none;
}

.daily-cell--claimed .daily-cell__check {
	display: flex;
}

/* 월간 — 6열 작은 칸 */
.daily-grid--month .daily-cell {
	width: 138px;
	height: 150px;
}

.daily-grid--month .daily-cell__day {
	top: 6px;
	left: 10px;
	font-size: 24px;
}

.daily-grid--month .daily-cell__icon {
	width: 72px;
	height: 72px;
	margin-bottom: 12px;
}

.daily-grid--month .daily-cell__count {
	bottom: 12px;
	height: 30px;
	font-size: 24px;
}

.daily-grid--month .daily-cell__check {
	left: 38px;
	right: 38px;
	top: 39px;
	bottom: 51px;
}
