<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="DailyBonus.uss" />

	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="daily-window">
			<ui:VisualElement class="tabs daily-tabs">
				<ui:Button name="tab-0" text="주간" class="tab" />
				<ui:Button name="tab-1" text="월간" class="tab" />
			</ui:VisualElement>
			<ui:VisualElement class="px-paper popup__window daily-frame">
				<ui:VisualElement class="px-wood popup__head item-head">
					<ui:Label name="title" text="" class="popup__name item-head__name" />
					<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
				</ui:VisualElement>
				<ui:Label name="time" text="" class="popup-hint" />
				<ui:VisualElement name="grid" class="daily-grid popup__body" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
