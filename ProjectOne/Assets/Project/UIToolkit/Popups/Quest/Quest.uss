/* 퀘스트 목록 팝업 */

.quest-list-box {
	height: 1200px;
	margin-bottom: 30px;
	padding: 12px;
}

.quest-list {
	flex-grow: 1;
}

.quest-row {
	flex-direction: row;
	align-items: center;
	padding: 16px 16px 20px 16px;
	margin-bottom: 10px;
	background-image: url("../../Pixel/row.png");
	-unity-slice-left: 4;
	-unity-slice-right: 4;
	-unity-slice-top: 4;
	-unity-slice-bottom: 4;
	-unity-slice-scale: 4px;
}

.quest-row--current {
	background-image: url("../../Pixel/row_active.png");
}

.quest-row--cleared .quest-row__number,
.quest-row--cleared .quest-row__text {
	opacity: 0.5;
}

.quest-row__number {
	width: 96px;
	font-size: 48px;
	color: var(--gold);
	-unity-text-align: middle-center;
}

.quest-row__text {
	flex-grow: 1;
	flex-shrink: 1;
	margin: 0 16px;
}

.quest-row__name {
	font-size: 48px;
}

.quest-row__desc {
	font-size: 36px;
	color: var(--ink-sub);
	white-space: normal;
}

.quest-row__reward {
	width: 152px;
	height: 152px;
}

.quest-row__reward .item-cell {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.quest-row__check {
	position: absolute;
	right: -8px;
	bottom: -8px;
	width: 52px;
	height: 52px;
	background-color: var(--green);
	border-width: 4px;
	border-color: var(--ink);
	border-radius: 26px;
}

.quest-row__claim {
	position: absolute;
	left: 0;
	right: 0;
	bottom: -6px;
	padding: 2px 0 6px 0;
	font-size: 36px;
	color: var(--white);
	-unity-text-align: middle-center;
	background-image: url("../../Pixel/chip_gold.png");
	-unity-slice-left: 3;
	-unity-slice-right: 3;
	-unity-slice-top: 3;
	-unity-slice-bottom: 3;
	-unity-slice-scale: 4px;
	-unity-text-outline-width: 1px;
	-unity-text-outline-color: var(--ink);
}
