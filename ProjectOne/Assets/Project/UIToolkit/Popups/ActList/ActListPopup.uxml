<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="../Popups.uss" />
	<Style src="ActList.uss" />

	<!-- 월드맵 — ◀ 월드 이름 ▶ 선택기 + 몇 번째 월드인지 점, 구역 줄(번호 원 · 이름 · 이동), 마을로 귀환.
	     월드가 계속 늘어나도 선택기 폭은 같다. 시안 Shared/Design/UI월드맵_선택기_시안.png 1안 -->
	<ui:VisualElement name="popup" class="popup theme-violet">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head item-head">
				<ui:Label text="월드맵" class="popup__name item-head__name" />
				<ui:Button name="close" text="" class="btn btn--icon item-head__close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>

			<ui:VisualElement class="world-select popup__body">
				<ui:VisualElement class="world-select__bar">
					<ui:Button name="prev" class="world-select__arrow"><ui:VisualElement class="world-select__tri world-select__tri--left" picking-mode="Ignore" /></ui:Button>
					<ui:Label name="act-name" text="" class="world-select__name" />
					<ui:Button name="next" class="world-select__arrow"><ui:VisualElement class="world-select__tri" picking-mode="Ignore" /></ui:Button>
				</ui:VisualElement>
				<!-- 점은 ActListPopup 이 월드 수만큼 만든다 -->
				<ui:VisualElement name="dots" class="world-select__dots" />
			</ui:VisualElement>

			<ui:VisualElement class="field-list-box popup__body">
				<ui:ScrollView name="list" class="field-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
			</ui:VisualElement>
			<ui:VisualElement class="popup__body world-town-row">
				<ui:Button name="town" text="마을로 귀환" class="world-town" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
