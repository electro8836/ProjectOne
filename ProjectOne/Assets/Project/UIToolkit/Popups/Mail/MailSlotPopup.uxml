<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../Popups.uss" />
	<Style src="Mail.uss" />

	<ui:VisualElement name="popup" class="popup">
		<ui:VisualElement name="dim" class="popup__dim" />
		<ui:VisualElement class="px-paper popup__window">
			<ui:VisualElement class="px-wood popup__head">
				<ui:Label text="우편" class="popup__name text-pop" />
				<ui:Button name="close" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
			<ui:Label name="head" text="" class="mail-head popup__body" />
			<ui:VisualElement class="px-inset popup-text-box">
				<ui:Label name="body" text="" class="popup-text" />
			</ui:VisualElement>
			<ui:VisualElement name="attachments" class="mail-attachments popup__body" />
			<ui:VisualElement class="popup__buttons">
				<ui:Button name="claim" text="받기" class="btn btn--green popup__button" />
				<ui:Button name="delete" text="삭제" class="btn btn--red popup__button" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
