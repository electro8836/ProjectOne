/* 바이올렛 테마 — 툴킷 전환 전 UGUI 탭 색(어두운 보라 / 선택 바이올렛) 기반의 깔끔형.
   탭·버튼 모양은 Layer Lab GUI Pro-FantasyHero 의 TabMenu 프리펩을 같은 스프라이트·색으로 구운 것이다.
   창 루트(.screen)에 .theme-violet 를 붙인 화면에만 적용된다. 부품은 UIToolkit/Violet (Tools/pixelui/generate_violet_ui.py).
   구운 버튼·탭은 쓰는 높이 그대로라 좌우만 9-slice(30px, 배율 1px)로 늘린다. */

.theme-violet.screen {
	background-color: #1C1730;
}

.theme-violet {
	text-shadow: 0 3px 0 #0A0814;
	-unity-text-outline-width: 0;	/* 어두운 바탕에 고정된 글자는 외곽선 없이 그림자만 */
}

/* 바탕이 밝거나 바뀌는 곳만 공통 외곽선(2px)을 다시 켠다 — 색 버튼, 선택 탭, 아이콘 위에 겹치는 칸 글자, 등급색 제목 줄 */
.theme-violet .btn--red,
.theme-violet .btn--green,
.theme-violet .btn--on,
.theme-violet .popup__button,
.theme-violet #stash,
.theme-violet .tab--selected,
.theme-violet .item-cell,
.theme-violet .item-head {
	-unity-text-outline-width: 2px;
	-unity-font-style: bold;	/* 외곽선은 획 안쪽도 반을 덮어 글자를 가늘게 만든다 — 합성 볼드로 그만큼 획을 두껍게 */
}

/* ── 제목 줄 — 화면 좌우·위를 꽉 채운 보라 판(#322958). 왼쪽 바이올렛이 오른쪽으로 길게 녹아들고(header_wash, 900px),
   판 아래로 그림자를 떨궈(기능 버튼 줄의 .header-shadow) 경계를 낸다. 테두리·장식은 두지 않는다.
   제목은 60px — 한·영·일 긴 이름도 들어가게(넘치면 말줄임), 오른쪽에 재화 캡슐 최대 3칸 ── */

.theme-violet .header {
	height: auto;
	background-image: none;
	margin: -6px -6px 0 -6px;
	padding: 0;
}

.theme-violet .header__frame {
	flex-grow: 1;
	flex-direction: row;
	align-items: center;
	height: 132px;
	padding: 0 16px 0 40px;
	background-color: #322958;
}

.theme-violet .header__wash {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 900px;
	background-image: url("../Violet/header_wash.png");
	-unity-background-scale-mode: stretch-to-fill;
}

/* 판 아래 그림자 — 기능 버튼 줄 맨 위에 깐다(버튼 줄이 제목 판보다 나중에 그려지므로 그 안에 둔다) */
.header-shadow {
	display: none;
}

.theme-violet .header-shadow {
	display: flex;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 24px;
	background-image: url("../Violet/header_shadow.png");
	-unity-background-scale-mode: stretch-to-fill;
}

.theme-violet .header__title {
	flex-grow: 1;
	flex-shrink: 1;
	font-size: 60px;
	text-shadow: 0 5px 0 #0A0814;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* 재화 캡슐 — 반투명 어두운 둥근 칸 + 보라 테두리. 아이콘 왼쪽, 수량 오른쪽 정렬 */
.theme-violet .header__currencies {
	flex-direction: row;
	flex-shrink: 0;
}

.theme-violet .currency-capsule {
	flex-direction: row;
	align-items: center;
	width: 196px;
	height: 56px;
	margin-left: 10px;
	padding: 0 18px 0 6px;
	border-radius: 28px;
	border-width: 3px;
	border-color: #6E5CAA;
	background-color: rgba(14, 10, 28, 0.67);
}

.theme-violet .currency-capsule__icon {
	width: 44px;
	height: 44px;
	flex-shrink: 0;
	-unity-background-scale-mode: scale-to-fit;
}

.theme-violet .currency-capsule__text {
	flex-grow: 1;
	margin: 0;
	padding: 0;
	font-size: 36px;
	color: #FFFFFF;
	-unity-text-align: middle-right;
	text-shadow: 0 3px 0 #0A0814;
}

/* ── 위 영역 — 어두운 남색 회색 면(#252A40) + 캐릭터 뒤 푸른 흰빛. 보라 일색을 피해 제목 판·탭만 보라로 둔다 ── */

/* 제목 바로 아래부터 시작한다 — 장착 칸 위아래 여백이 같게(16 + 칸 여백 5) */
.theme-violet .top {
	background-image: none;
	background-color: #252A40;
	margin: 0 -6px;
	padding-top: 16px;
	padding-bottom: 12px;
}

/* 캐릭터 뒤 빛 — 흰 빛(glow_white)에 배경색과 어울리는 푸른 흰빛을 입힌다 */
.theme-violet .stage {
	background-image: url("../Violet/glow_white.png");
	-unity-background-image-tint-color: #B4C6FF;
	-unity-background-scale-mode: scale-to-fit;
}

/* 장착 칸 — 152 → 188px 로 키운다(기능 버튼 줄이 빠진 자리를 칸으로 채운다). 4칸 x (188 + 위아래 10) = 792.
   시안 Shared/Design/UI장비_D배치_버튼디자인_시안.png */
.theme-violet .top__body {
	height: 792px;
}

.theme-violet .equip-column {
	width: 188px;
	margin: 0 8px;
}

.theme-violet .equip-slot {
	width: 188px;
	height: 188px;
	margin: 5px 0;
}

/* 이름 양옆 장식선은 쓰지 않는다 */
.theme-violet .stage__ornament {
	display: none;
}

.theme-violet .stage__level {
	color: #CFCAEE;
}

.theme-violet .stage__power {
	color: #FFD447;
	text-shadow: 0 4px 0 #0A0814;
}

/* 보관함 — 기능 버튼 줄·위 영역을 덮으므로 면을 깐다. 두 줄처럼 화면 여백 6px 까지 넓히고, 안쪽 여백은 가방과 같게(32px) 해 칸 줄을 맞춘다 */
.theme-violet .stash {
	left: -6px;
	right: -6px;
	padding-left: 32px;
	padding-right: 32px;
	background-image: none;
	background-color: #252A40;
}

.theme-violet .stash__capacity {
	color: #A8A2CC;
}

/* ── 버튼 — TabMenu_Middle_01(Nomal) 모양. 위험(분해)만 붉은 색 ── */

.theme-violet .btn {
	background-image: url("../Violet/btn_face.png");
	-unity-slice-left: 30;
	-unity-slice-right: 30;
	-unity-slice-top: 0;
	-unity-slice-bottom: 0;
	-unity-slice-scale: 1px;
	padding-bottom: 0;
	color: #CED3FB;
	text-shadow: 0 3px 0 #0A0814;
}

.theme-violet .btn--gold {
	background-image: url("../Violet/btn_face.png");
}

.theme-violet .btn--red {
	background-image: url("../Violet/btn_danger.png");
	color: #FFFFFF;
}

/* 켜진 토글 버튼(보관함 열림) — 초록 면으로 상태를 보인다 */
.theme-violet .btn--on {
	background-image: url("../Violet/btn_active.png");
	color: #FFFFFF;
}

.theme-violet .btn:active {
	translate: 0 3px;
	-unity-background-image-tint-color: #C8C8C8;
}

/* ── 능력치·재화 버튼 — 전투력 아래. 어두운 알약 왼쪽에 둥근 색 뱃지(아이콘)가 튀어나온다.
   글자는 뱃지 오른쪽 남은 칸이 아니라 알약 쪽 가운데에 가깝게(왼쪽 여백 20) — 시안 UI장비_버튼글자크기_시안.png B ── */

.theme-violet .stage__info {
	margin-bottom: 0;
}

.theme-violet .stage__buttons {
	flex-direction: row;
	margin: 8px 0 0 0;
}

.theme-violet .stage-btn,
.theme-violet .stage-btn:hover,
.theme-violet .stage-btn:active {
	width: 212px;
	height: 60px;
	margin: 0 7px;
	padding: 0;
	border-width: 0;
	background-image: none;
	background-color: rgba(0, 0, 0, 0);
}

.theme-violet .stage-btn:active {
	scale: 0.95 0.95;
}

.theme-violet .stage-btn__pill {
	position: absolute;
	left: 24px;
	right: 0;
	top: 6px;
	bottom: 6px;
	justify-content: center;
	padding-left: 20px;
	border-width: 3px;
	border-color: #0A0814;
	border-radius: 24px;
	background-color: #2E294A;
}

.theme-violet .stage-btn__label {
	margin: 0;
	padding: 0;
	-unity-text-align: middle-center;
	font-size: 32px;
	color: #F0ECFF;
	-unity-text-outline-width: 0;
	text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.theme-violet .stage-btn__badge {
	position: absolute;
	left: -2px;
	top: -4px;
	width: 68px;
	height: 68px;
	align-items: center;
	justify-content: center;
	border-width: 4px;
	border-color: #0A0814;
	border-radius: 34px;
}

.theme-violet .stage-btn--stat .stage-btn__badge {
	background-color: #2E57A8;
}

.theme-violet .stage-btn--currency .stage-btn__badge {
	background-color: #A06A1E;
}

.theme-violet .stage-btn__icon {
	width: 38px;
	height: 38px;
	-unity-background-scale-mode: scale-to-fit;
}

.theme-violet .stage-btn--stat .stage-btn__icon {
	background-image: url("../Violet/extraicon_stat.png");
}

.theme-violet .stage-btn--currency .stage-btn__icon {
	background-image: url("../Violet/extraicon_currency.png");
}

/* ── 분류 탭 — TabMenu_BottomFlush_02. 선택 탭은 버튼 전체가 바이올렛, 가방 패널 위에 붙는다 ── */

.theme-violet .tabs {
	background-color: #252A40;
	padding: 0 12px;
	margin: 0 -6px;
}

.theme-violet .tab {
	background-image: url("../Violet/tab_off.png");
	-unity-slice-left: 30;
	-unity-slice-right: 30;
	-unity-slice-top: 0;
	-unity-slice-bottom: 0;
	-unity-slice-scale: 1px;
	margin: 0 -2px;
	padding: 0;
	translate: 0 0;
	color: #CED3FB;
}

.theme-violet .tab--selected {
	background-image: url("../Violet/tab_on.png");
	color: #FFFFFF;
}

/* 탭 글자(전체)·아이콘 — 탭 가운데. 도트 글꼴은 글자 위쪽 여백이 적어 위로 쏠려 보여 글자 탭만 아래로 8px 내린다 */
.theme-violet .tab {
	-unity-text-align: middle-center;
}

.theme-violet #tab-0 {
	padding-top: 8px;
}

/* 분류 아이콘 — tabicon_*(Icon_Gear 결, generate_violet_ui.py tab_icons). 그림은 Theme.uss 의 .type-* 가 입힌다 */
.theme-violet .tab__icon {
	width: 64px;
	height: 64px;
	flex-shrink: 0;
	opacity: 0.7;
}

.theme-violet .tab--selected .tab__icon {
	opacity: 1;
}

/* ── 가방 — 면 하나 ── */

/* 가방 — 화면 여백 6px 까지 좌우로 넓혀 바탕(검은 줄)이 보이지 않게. 안쪽 여백도 6px 늘려 칸 줄 폭(1016)은 그대로 */
.theme-violet .bag {
	margin: 0 -6px;
	padding-left: 32px;
	padding-right: 32px;
	background-image: none;
	background-color: #3A3060;
	border-top-width: 4px;
	border-top-color: #6D5ACD;
}

.theme-violet .bag__caption {
	font-size: 48px;
	color: #FFFFFF;
	text-shadow: 0 4px 0 #0A0814;
}

.theme-violet .bag__capacity {
	font-size: 40px;
	color: #A8A2CC;
}

/* 칸 줄 — 칸 5개가 툴바 양끝(분해 버튼 오른쪽 끝)까지 꽉 차게. 줄 폭 1016 = 칸 196.8 x 5 + 사이 8 x 4.
   칸 여백 4px 를 줄의 음수 여백으로 상쇄해 양끝을 맞춘다(반올림 넘침을 피해 칸은 196.6) */
.theme-violet .item-grid {
	margin: 0 -4px;
}

.theme-violet .item-grid .item-cell {
	width: 196.6px;
	height: 196.6px;
	margin: 4px;
}

/* ── 아이템 칸 — 두툼한 둥근 틀(slot_round, 회색조)을 등급 테두리색으로 틴트하고,
   안쪽은 가운데가 가장 밝은 등급 바탕 판(cell_glow, 등급 바탕색 틴트)을 깐다.
   틀은 위 10px · 옆 11px · 아래 15px — 아래가 두꺼워 칸이 살짝 솟아 보인다. 내용물은 이 안쪽에 맞춘다 ── */

.theme-violet .item-cell,
.theme-violet .equip-slot {
	background-image: url("../Violet/slot_round.png");
	-unity-slice-left: 32;
	-unity-slice-right: 32;
	-unity-slice-top: 32;
	-unity-slice-bottom: 32;
	-unity-slice-scale: 1px;
}

/* 빈 장착 칸 — 보라 틀. 틀(slot_round) 안쪽은 비어 있어 어두운 면을 깐다(제작 등록 칸과 같다) */
.theme-violet .equip-slot {
	-unity-background-image-tint-color: #6A5E90;
	border-radius: 24px;
	background-color: #191C2C;
}

/* 빈 칸 부위 아이콘 — 분류 탭 아이콘 결의 단색 그림(sloticon_*, generate_violet_ui.py slot_icons).
   크기는 칸(188px)의 약 57%(108px), 틀 아랫변이 윗변보다 5px 두꺼워 안쪽 가운데에 맞춰 3px 올린다 */
.theme-violet .equip-slot__placeholder {
	left: 40px;
	right: 40px;
	top: 37px;
	bottom: 43px;
	opacity: 0.45;
}

.theme-violet .slot-weapon {
	background-image: url("../Violet/sloticon_weapon.png");
}

.theme-violet .slot-helmet {
	background-image: url("../Violet/sloticon_helmet.png");
}

.theme-violet .slot-armor {
	background-image: url("../Violet/sloticon_armor.png");
}

.theme-violet .slot-gloves {
	background-image: url("../Violet/sloticon_gloves.png");
}

.theme-violet .slot-boots {
	background-image: url("../Violet/sloticon_boots.png");
}

.theme-violet .slot-ring {
	background-image: url("../Violet/sloticon_ring.png");
}

.theme-violet .slot-amulet {
	background-image: url("../Violet/sloticon_amulet.png");
}

.theme-violet .slot-relic {
	background-image: url("../Violet/sloticon_relic.png");
}

/* 등급 바탕 판 — 틀 바로 안쪽. 색은 View 가 틴트(-unity-background-image-tint-color)로 칠한다 */
.theme-violet .item-cell__bg {
	left: 11px;
	right: 11px;
	top: 10px;
	bottom: 15px;
	opacity: 1;
	border-radius: 12px;
	background-image: url("../Violet/cell_glow.png");
	-unity-background-scale-mode: stretch-to-fill;
}

/* 장비 아이콘 — 틀 안쪽에서 레벨·품질 막대 자리를 남기고 가운데 */
.theme-violet .item-cell__icon {
	left: 22px;
	right: 22px;
	top: 18px;
	bottom: 30px;
}

/* 분류 배지 — 틀 안쪽 왼쪽 위 모서리에 딱 붙인다. 고정 바탕(ItemCell.uss) + 진한 테두리,
   왼쪽 위는 틀 안쪽 모서리(반지름 12px)와 같게, 반대쪽 아래 모서리만 살짝 둥글게 */
.theme-violet .item-cell__type {
	left: 11px;
	top: 10px;
	border-width: 3px;
	border-color: #0E0B1A;
	border-top-left-radius: 12px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 10px;
	padding: 2px;
}

/* 잠금 — 어두운 둥근 사각 배지 안 빨간 자물쇠(icon_lock, 2배로 구움). 틀 안쪽 오른쪽 위 모서리에 붙인다 */
.theme-violet .item-cell__lock {
	right: 11px;
	top: 10px;
	width: 40px;
	height: 40px;
	background-image: url("../Violet/icon_lock.png");
}

/* 레벨·개수 — 어두운 둥근 배지 위 32px ExtraBold(Theme.uss) + 공통 외곽선 2px + 아래 그림자 3px.
   밝은 아이콘 위에서도 읽힌다 */
.theme-violet .item-cell__level,
.theme-violet .item-cell__count {
	bottom: 28px;
	padding: 0 10px 2px 10px;
	border-radius: 10px;
	background-color: rgba(10, 8, 20, 0.7);
	font-size: 32px;
	text-shadow: 0 3px 0 #0A0814;
}

/* 장착 표시 — 어두운 배지 안 초록 E(icon_equip). 오른쪽 위 모서리에 붙이고, 잠금이 함께 있으면 잠금이 그 아래로 내려간다 */
.theme-violet .item-cell__equip {
	right: 11px;
	top: 10px;
	width: 40px;
	height: 40px;
	padding: 0;
	background-image: url("../Violet/icon_equip.png");
	-unity-slice-left: 0;
	-unity-slice-right: 0;
	-unity-slice-top: 0;
	-unity-slice-bottom: 0;
}

.theme-violet .item-cell__equip-text {
	display: none;
}

.theme-violet .item-cell--equipped .item-cell__lock {
	top: 54px;
}

.theme-violet .item-cell__level {
	left: 15px;
}

.theme-violet .item-cell__count {
	right: 15px;
}

/* 품질 막대 — 틀 아랫변 바로 위에 얇게 */
.theme-violet .item-cell__quality {
	left: 15px;
	right: 15px;
	bottom: 18px;
	height: 8px;
	border-radius: 4px;
	overflow: hidden;
}

.theme-violet .item-cell__quality-fill {
	border-top-width: 2px;
}

/* 장착 칸(168px) — 가방 칸과 같은 틀·자리, 배지는 40px(EquipmentScreen.uss)라 자물쇠도 같은 비율로 줄인다 */
.theme-violet .equip-slot .item-cell__type {
	left: 11px;
	top: 10px;
	padding: 2px;
}

.theme-violet .equip-slot .item-cell__lock {
	width: 34px;
	height: 34px;
}

/* ── 아이템 정보 팝업 — 제목 줄만 등급색(판·아래 선·등급 박스는 ItemInfoPopup 이 칠한다), 아래 본문은 등급과 무관한 회색.
   장착 초록·강화 주황·닫기는 프레임 없는 X ── */

.theme-violet .popup__window {
	padding-bottom: 24px;		/* 버튼 줄 아래 여백 — 스크롤 칸 아래 여백(24px)과 같게 */
	background-image: none;
	background-color: #313338;
	border-width: 4px;
	border-color: #44464E;
}

.theme-violet .popup__head {
	background-image: none;
	background-color: #44464E;
}

.theme-violet .popup__name {
	text-shadow: 0 5px 0 #0A0814;
}

/* 제목 줄 — 높이를 줄이고 이름을 정가운데에. 아래 선(6px) 가운데에 등급 박스가 걸쳐 절반이 본문으로 내려온다.
   이름은 한 줄 60px — 안 들어가는 긴 이름은 ItemInfoPopup 이 48px(--medium)·36px(--small)로 줄인다(양옆 120px 은 X 자리) */
.theme-violet .item-head {
	height: auto;
	min-height: 136px;
	padding: 12px 120px 12px 120px;
	margin-bottom: 52px;
	justify-content: center;
	border-bottom-width: 6px;
	border-bottom-color: #5E6068;
}

.theme-violet .item-head__name {
	flex-grow: 1;
	font-size: 60px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	text-shadow: 0 5px 0 #0A0814;
}

.theme-violet .item-head__name--medium {
	font-size: 48px;
	text-shadow: 0 4px 0 #0A0814;
}

.theme-violet .item-head__name--small {
	font-size: 36px;
	text-shadow: 0 3px 0 #0A0814;
}

/* 등급 박스 — 36px 글자(박스 높이 57px). 60px 이름과 겹치지 않게 박스 가운데를 아래 선(6px) 가운데보다 8px 아래에 둔다.
   모서리는 둥글게, 폭은 최소 220px — 더 긴 등급 이름·다른 언어는 글자만큼 늘어난다 */
.theme-violet .item-head__grade {
	position: absolute;
	left: 50%;
	bottom: -41px;
	translate: -50% 0;
	min-width: 220px;
	padding: 2px 32px 6px 32px;
	border-radius: 18px;
	font-size: 36px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	border-width: 3px;
	border-color: #0A0814;
	text-shadow: 0 3px 0 #0A0814;
}

/* 닫기 X — 프레임 없이 X 만, 제목 줄 오른쪽 세로 가운데.
   가운데 정렬은 위 여백(-높이/2)으로 한다 — translate 로 하면 누를 때의 눌림 연출(.btn:active translate)이 덮어써 아래로 튄다 */
.theme-violet .item-head__close {
	position: absolute;
	right: 12px;
	top: 50%;
	margin-top: -48px;
	background-image: none;
}

.theme-violet .popup__window .section-title {
	color: #F2F2F5;
}

/* 설명 판 — 옵션 상자와 같은 회색. 짧아도 2줄 높이(줄 48px x 2 + 위아래 여백 40), 길면 내용만큼 늘어난다 */
.theme-violet .equip-info-desc {
	color: #C8C9CF;
	min-height: 136px;
	padding: 18px 22px 22px 22px;
	margin-bottom: 20px;
	background-color: #26272C;
}

.theme-violet .option-box {
	background-image: none;
	background-color: #26272C;
	border-width: 0;
}

/* 큰 버튼 — 112px 로 구운 면, 48px 글자는 도트 1칸(4px) 그림자.
   외곽선은 공통 2px(Theme.uss :root) */
.theme-violet .popup__button {
	height: 112px;
	font-size: 48px;
	color: #FFFFFF;
	text-shadow: 0 4px 0 #0A0814;
}

.theme-violet #equip {
	background-image: url("../Violet/btn_equip.png");
}

.theme-violet #enchant {
	background-image: url("../Violet/btn_enchant.png");
}

/* 보관함 이동 — 창 밖 아래 88px 버튼(#D45012). 36px 글자는 도트 1칸(3px) 그림자 */
.theme-violet #stash {
	background-image: url("../Violet/btn_stash.png");
	color: #FFFFFF;
	text-shadow: 0 3px 0 #0A0814;
}

/* 닫기 X 아이콘 — Icon_Close_02 를 본뜬 크림색 X(외곽선·그림자 포함 58x62).
   그림자 몫 4px 때문에 X 몸통이 그림 가운데보다 2px 위라, 위 여백 4px 로 내려 가운데에 맞춘다 */
.theme-violet .icon-close {
	width: 58px;
	height: 62px;
	margin-top: 4px;
	background-image: url("../Violet/icon_close.png");
}

/* 딤 — 뒤 화면을 더 어둡게 눌러 팝업을 띄운다 */
.theme-violet.popup--open .popup__dim {
	background-color: rgba(4, 2, 10, 0.96);
}

/* 잠금 켜짐 — 초록 */
.theme-violet .btn--green {
	background-image: url("../Violet/btn_active.png");
	color: #FFFFFF;
}

/* ── 팝업 공통 안쪽 상자 — 나무판 상자 대신 아이템 설명 판과 같은 진한 회색(팝업에만, 창 화면은 그대로) ── */
.theme-violet.popup .px-inset {
	background-image: none;
	background-color: #26272C;
}
