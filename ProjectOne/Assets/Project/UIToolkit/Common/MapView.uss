/* 지도 뷰 (MapView) — HUD 미니맵과 월드맵 창이 같이 쓴다.
   뷰포트(.map-view)가 잘라 보이고, 안쪽 판(.map-view__content)에 지도 이미지·표시·히어로가 얹힌다.
   표시는 판 위 비율 좌표에 크기 0 으로 놓이고 아이콘·글자가 그 점을 중심으로 펼쳐진다 —
   줌(판 크기)이 바뀌어도 아이콘·글자 크기는 그대로다. */

.map-view {
	overflow: hidden;
	background-color: #1A2133;
}

.map-view__content {
	position: absolute;
	-unity-background-scale-mode: stretch-to-fill;
}

.map-marker {
	position: absolute;
	width: 0;
	height: 0;
}

/* 아이콘 — 밝은 바닥 위에서도 보이게 남색 원 위에 얹는다 */
.map-marker__icon {
	position: absolute;
	left: -16px;
	top: -16px;
	width: 32px;
	height: 32px;
	border-width: 2px;
	border-radius: 16px;
	border-color: #0A0814;
	background-color: #2B3456;
	background-size: 70% 70%;
	-unity-background-scale-mode: scale-to-fit;
}

.map-marker__label {
	position: absolute;
	left: -100px;
	top: 16px;
	width: 200px;
	margin: 0;
	padding: 0;
	font-size: 18px;
	-unity-font-definition: url("../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-align: upper-center;
	-unity-text-outline-width: 2px;
	-unity-text-outline-color: #0A0814;
	text-shadow: 0 0 0 rgba(0, 0, 0, 0);
	color: #FFFFFF;
	white-space: nowrap;
}

/* 필드보스 — 해골은 주황, 처치 후(리젠 대기)에는 회색 + 남은 시간 */
.map-marker--boss .map-marker__icon {
	background-color: #7A2E1E;
	-unity-background-image-tint-color: #FFB27A;
}

.map-marker--boss .map-marker__label {
	color: #FFB27A;
}

.map-marker--dead .map-marker__icon {
	background-color: #3A3A46;
	-unity-background-image-tint-color: #9A9AA6;
}

.map-marker--dead .map-marker__label {
	color: #D8D8E0;
}

/* 히어로 — 흰 테두리 노란 점. 좌표가 점의 중심이 되게 절반만큼 당긴다. */
.map-view__hero {
	position: absolute;
	width: 20px;
	height: 20px;
	translate: -50% -50%;
	border-width: 3px;
	border-radius: 10px;
	border-color: #FFFFFF;
	background-color: #FFC83D;
}
