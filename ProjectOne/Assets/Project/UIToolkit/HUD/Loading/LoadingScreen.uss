/* 로딩 화면 — 로딩 그림 위, 아래를 어둡게 물들이고 단계 문구 + 알약 게이지. */

.loading {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	justify-content: flex-end;
	background-color: #191A29;
	background-image: url("../../../Art/UI/Atlas/Textures/Illusts/Title/Image_LoadingBg_01.png");
	-unity-background-scale-mode: scale-and-crop;
}

/* 아래 어둠 — 위는 투명, 아래로 갈수록 잉크색 */
.loading__shade {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 460px;
	background-image: url("../../Violet/loading_shade.png");
	-unity-background-scale-mode: stretch-to-fill;
}

.loading__bottom {
	padding: 0 90px 200px 90px;
	align-items: stretch;
}

.loading__phase {
	margin: 0 0 22px 0;
	padding: 0;
	font-size: 46px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 4px 0 #0A0814;
}

/* 알약 막대 — 어두운 홈 + 잉크 테두리 */
.loading__bar {
	height: 72px;
	padding: 4px;
	border-width: 4px;
	border-color: #0A0814;
	border-radius: 36px;
	background-color: #181720;
}

/* 채움 — 보라, 위쪽에 밝은 줄. 너비는 LoadingUI 가 퍼센트로 정한다 */
.loading__fill {
	height: 100%;
	border-radius: 28px;
	background-color: #7C68E4;
}

.loading__shine {
	position: absolute;
	left: 10px;
	right: 10px;
	top: 5px;
	height: 14px;
	border-radius: 7px;
	background-color: #9684F0;
}

.loading__percent {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	margin: 0;
	padding: 0;
	-unity-text-align: middle-center;
	font-size: 34px;
	color: #FFFFFF;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 3px 0 #0A0814;
}
