<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="LoadingScreen.uss" />
	<!-- 로딩 — 타이틀 그림, 아래를 어둡게 물들이고 단계 문구 + 알약 게이지(퍼센트는 막대 안).
	     시안 Shared/Design/UI로딩_시안.png 3안 -->
	<ui:VisualElement class="loading">
		<ui:VisualElement class="loading__shade" picking-mode="Ignore" />
		<ui:VisualElement class="loading__bottom">
			<ui:Label name="phase-text" text="Loading..." class="loading__phase" />
			<ui:VisualElement class="loading__bar">
				<ui:VisualElement name="progress-fill" class="loading__fill">
					<ui:VisualElement class="loading__shine" />
				</ui:VisualElement>
				<ui:Label name="progress-text" text="0%" class="loading__percent" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
