<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="Notice.uss" />
	<!-- 경고(알약 + 보라 i)·시스템(화면 폭 잉크 띠, 최대 2줄)이 같이 쓴다. -->
	<ui:VisualElement class="notice-layer" picking-mode="Ignore">
		<ui:VisualElement name="notice" class="notice pill" picking-mode="Ignore">
			<ui:VisualElement class="pill__icon" picking-mode="Ignore">
				<ui:Label text="i" class="pill__icon-text" picking-mode="Ignore" />
			</ui:VisualElement>
			<ui:Label name="text" text="" class="pill__text" picking-mode="Ignore" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
