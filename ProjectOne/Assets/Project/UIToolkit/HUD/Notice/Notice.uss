/* 알림 메시지 — 화면 위에 떠 있는 글 상자들. 입력은 받지 않는다. */

.notice-layer {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	align-items: center;
}

/* 알약 — 경고·제한 공통. 잉크 테두리의 둥근 판 + 왼쪽 원 아이콘, 글자가 길면 최대 2줄 */
.pill {
	position: absolute;
	flex-direction: row;
	align-items: center;
	max-width: 960px;
	min-height: 92px;
	padding: 10px 44px 10px 18px;
	border-width: 4px;
	border-color: #0A0814;
	border-radius: 46px;
	background-color: #161420;
}

.pill__icon {
	width: 54px;
	height: 54px;
	flex-shrink: 0;
	margin-right: 18px;
	align-items: center;
	justify-content: center;
	border-width: 3px;
	border-color: #0A0814;
	border-radius: 27px;
	background-color: #7C68E4;
}

.pill__icon-text {
	margin: 0;
	padding: 0;
	font-size: 34px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.pill__text {
	flex-shrink: 1;
	max-height: 96px;
	overflow: hidden;
	text-overflow: ellipsis;	/* 2줄을 넘으면 끝을 … 로 자른다 */
	margin: 0;
	padding: 0;
	font-size: 36px;
	color: #FFFFFF;
	white-space: normal;
	-unity-text-align: middle-center;
	text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* 잠깐 떴다 사라지는 메시지 — 위치는 프리펩마다 다른 클래스 */
.notice {
	opacity: 0;
	transition-property: opacity;
}

.notice--shown {
	opacity: 1;
	transition-duration: 0s;
}

.notice--alert {
	top: 820px;
}

/* 시스템 메시지 — 맨 위 층(System)이라 다른 UI 와 겹친다. 확실히 읽히게 화면 폭 전체를
   불투명 잉크 띠로 덮고 위아래 보라 선을 긋는다. 글자가 길면 띠가 2줄까지 늘어난다 */
.notice--system {
	top: 260px;
	left: 0;
	right: 0;
	max-width: none;
	min-height: 108px;
	padding: 16px 40px 16px 40px;
	justify-content: center;
	border-radius: 0;
	border-left-width: 0;
	border-right-width: 0;
	border-top-color: #A893FF;
	border-bottom-color: #A893FF;
}

.notice--system .pill__icon {
	display: none;
}

.notice--system .pill__text {
	max-height: 100px;
	font-size: 38px;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	text-shadow: 0 3px 0 #0A0814;
}

/* 제한 메시지 — 빨강 알약, 숨길 때까지 떠 있다 */
.pill--warning {
	top: 980px;
	background-color: #2C0E16;
}

.pill__icon--warning {
	background-color: #FF6B6B;
}

/* 레벨업 — 판 없이 화면 폭 보라 띠(위아래 금 선) 위에 금 글자. 작게 시작해 튀어나온 뒤 사라진다 */
.levelup {
	position: absolute;
	top: 470px;
	left: 0;
	right: 0;
	height: 190px;
	align-items: center;
	justify-content: center;
	background-image: url("../../Violet/levelup_band.png");
	-unity-background-scale-mode: stretch-to-fill;
	-unity-slice-top: 4;
	-unity-slice-bottom: 4;
	-unity-slice-scale: 1px;
	opacity: 0;
	scale: 0.5 0.5;
	transition-property: opacity, scale;
	transition-duration: 0s;
}

.levelup--shown {
	opacity: 1;
	scale: 1 1;
	transition-duration: 0.25s;
	transition-timing-function: ease-out-back;
}

.levelup--fading {
	opacity: 0;
	transition-duration: 0.5s;
	transition-timing-function: linear;
}

/* 제목 뒤 보라 빛 */
.levelup__glow {
	position: absolute;
	top: -110px;
	width: 360px;
	height: 300px;
	background-image: url("../../Violet/glow_white.png");
	-unity-background-image-tint-color: #A893FF;
	-unity-background-scale-mode: stretch-to-fill;
	opacity: 0.55;
}

.levelup__title {
	margin: 0;
	padding: 0;
	font-size: 64px;
	color: #FFD166;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	text-shadow: 0 5px 0 #0A0814;
}

.levelup__sub {
	flex-direction: row;
	margin-top: 10px;
}

.levelup__line {
	margin: 0;
	padding: 0;
	font-size: 34px;
	color: #FFFFFF;
	text-shadow: 0 3px 0 #0A0814;
}

.levelup__dot {
	margin: 0 14px;
}
