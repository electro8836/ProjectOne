<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="Notice.uss" />
	<!-- 제한 — 빨강 알약 + ! 아이콘. -->
	<ui:VisualElement class="notice-layer" picking-mode="Ignore">
		<ui:VisualElement name="warning" class="pill pill--warning" picking-mode="Ignore">
			<ui:VisualElement class="pill__icon pill__icon--warning" picking-mode="Ignore">
				<ui:Label text="!" class="pill__icon-text" picking-mode="Ignore" />
			</ui:VisualElement>
			<ui:Label name="text" text="" class="pill__text" picking-mode="Ignore" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
