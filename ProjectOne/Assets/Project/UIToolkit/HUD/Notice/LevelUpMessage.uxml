<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="Notice.uss" />
	<!-- 레벨업 — 판 없이 화면 폭 보라 띠(금 선) 위에 금 글자 + 보라 빛. 시안 Shared/Design/UI알림메시지_시안.png 2안 -->
	<ui:VisualElement class="notice-layer" picking-mode="Ignore">
		<ui:VisualElement name="levelup" class="levelup" picking-mode="Ignore">
			<ui:VisualElement class="levelup__glow" picking-mode="Ignore" />
			<ui:Label name="levelup-text" text="" class="levelup__title" picking-mode="Ignore" />
			<ui:VisualElement class="levelup__sub" picking-mode="Ignore">
				<ui:Label name="level-text" text="" class="levelup__line" picking-mode="Ignore" />
				<ui:Label text="·" class="levelup__line levelup__dot" picking-mode="Ignore" />
				<ui:Label name="desc-text" text="" class="levelup__line" picking-mode="Ignore" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
