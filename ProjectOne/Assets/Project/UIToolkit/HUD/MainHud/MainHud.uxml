<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/MapView.uss" />
	<Style src="MainHud.uss" />

	<!-- 메인 HUD — 화면 전체를 덮지만 빈 곳은 클릭을 통과시킨다(아래 조이스틱이 받는다) -->
	<ui:VisualElement name="hud" class="hud" picking-mode="Ignore">

		<!-- 왼쪽 위: 히어로 정보 — 레벨 원(테두리 고리가 경험치)이 체력바 왼쪽 끝을 덮고, 체력바 아래 탭에 전투력 -->
		<ui:VisualElement name="hero-info" class="hero-info" picking-mode="Ignore">
			<ui:VisualElement class="hero-info__bars" picking-mode="Ignore">
				<ui:VisualElement class="hero-info__power" picking-mode="Ignore">
					<ui:VisualElement class="hero-info__power-icon" picking-mode="Ignore" />
					<ui:Label name="power-text" class="hero-info__power-text hud-text" picking-mode="Ignore" />
				</ui:VisualElement>
				<ui:VisualElement class="hud-gauge hud-gauge--hp" picking-mode="Ignore">
					<ui:VisualElement name="hp-fill" class="hud-gauge__fill" picking-mode="Ignore" />
					<ui:Label name="hp-text" class="hud-gauge__text hero-info__hp-text hud-text" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:VisualElement name="level-ring" class="hero-info__ring" picking-mode="Ignore">
				<ui:VisualElement class="hero-info__ring-core" picking-mode="Ignore">
					<ui:Label name="level-text" class="hero-info__level hud-text" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:VisualElement>
		</ui:VisualElement>


		<!-- 현재 퀘스트 — 왼쪽 위. 카드(제목·내용 2줄·진행도) + 오른쪽에 붙은 접기 버튼. 접으면 통째로 왼쪽으로 밀려 버튼만 남는다. 달성하면 테두리·게이지·버튼이 초록 -->
		<ui:VisualElement name="quest-info" class="quest-info" picking-mode="Ignore">
			<ui:VisualElement name="quest-frame" class="quest-frame">
				<ui:VisualElement class="quest-frame__head" picking-mode="Ignore">
					<ui:VisualElement class="quest-frame__icon" picking-mode="Ignore" />
					<ui:Label name="quest-title" class="quest-frame__title" picking-mode="Ignore" />
				</ui:VisualElement>
				<ui:Label name="quest-desc" class="quest-frame__desc" picking-mode="Ignore" />
				<ui:VisualElement class="quest-frame__progress" picking-mode="Ignore">
					<ui:Label name="quest-label" class="quest-frame__label" picking-mode="Ignore" />
					<ui:Label name="quest-count" class="quest-frame__count" picking-mode="Ignore" />
				</ui:VisualElement>
				<ui:VisualElement class="quest-frame__bar" picking-mode="Ignore">
					<ui:VisualElement name="quest-fill" class="quest-frame__fill" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:Button name="quest-fold" class="quest-tab">
				<ui:VisualElement class="quest-tab__arrow" picking-mode="Ignore" />
			</ui:Button>
		</ui:VisualElement>

		<!-- 내 버프 -->
		<ui:VisualElement name="buff-list" class="buff-list" picking-mode="Ignore" />

		<!-- 오른쪽 위: 재화 + 메뉴 -->
		<ui:VisualElement class="top-right" picking-mode="Ignore">
			<ui:VisualElement class="resource" picking-mode="Ignore">
				<ui:VisualElement name="gold-icon" class="resource__icon" picking-mode="Ignore" />
				<ui:Label name="gold-text" class="resource__text hud-text" picking-mode="Ignore" />
			</ui:VisualElement>
			<ui:VisualElement class="resource" picking-mode="Ignore">
				<ui:VisualElement name="dia-icon" class="resource__icon" picking-mode="Ignore" />
				<ui:Label name="dia-text" class="resource__text hud-text" picking-mode="Ignore" />
			</ui:VisualElement>
			<ui:Button name="menu-button" class="menu-button">
				<ui:VisualElement class="menu-button__icon" picking-mode="Ignore" />
				<ui:VisualElement name="menu-badge" class="hud-badge" picking-mode="Ignore" />
			</ui:Button>
		</ui:VisualElement>

		<!-- 미니맵 — 메뉴 버튼 아래. 흑철 3중 링 원형 지도(히어로가 가운데) + 왼쪽 아래 확장(월드맵) + 오른쪽 줌 +/-.
		     링은 겹친 원 4개(검정 → 쇠 → 안쪽 쇠 → 검정)로 만들고, 버튼은 검정 테 + 금 테 + 흑회 판 -->
		<ui:VisualElement name="minimap" class="minimap" picking-mode="Ignore">
			<ui:VisualElement class="minimap__ring minimap__ring--ink" picking-mode="Ignore">
				<ui:VisualElement class="minimap__ring minimap__ring--iron" picking-mode="Ignore">
					<ui:VisualElement class="minimap__ring minimap__ring--iron-dark" picking-mode="Ignore">
						<ui:VisualElement class="minimap__ring minimap__ring--inner-ink" picking-mode="Ignore">
							<ui:VisualElement name="minimap-view" class="minimap__view map-view" picking-mode="Ignore" />
						</ui:VisualElement>
					</ui:VisualElement>
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:Button name="minimap-expand" class="minimap__button minimap__button--expand">
				<ui:VisualElement class="minimap__face" picking-mode="Ignore">
					<ui:VisualElement class="minimap__icon minimap__icon--expand" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:Button>
			<ui:Button name="minimap-zoom-in" class="minimap__button minimap__button--zoom-in">
				<ui:VisualElement class="minimap__face" picking-mode="Ignore">
					<ui:VisualElement class="minimap__icon minimap__icon--plus" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:Button>
			<ui:Button name="minimap-zoom-out" class="minimap__button minimap__button--zoom-out">
				<ui:VisualElement class="minimap__face" picking-mode="Ignore">
					<ui:VisualElement class="minimap__icon minimap__icon--minus" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:Button>
		</ui:VisualElement>

		<!-- 맵 이름 (필드·던전) — 미니맵 원 아래쪽에 걸쳐 붙는 판(검정 테 + 금 테 + 흑회 판). 원 위에 그려지도록 미니맵 뒤에 둔다 -->
		<ui:VisualElement name="map-info" class="map-info" picking-mode="Ignore">
			<ui:VisualElement class="map-info__box" picking-mode="Ignore">
				<ui:Label name="map-text" class="map-info__text" picking-mode="Ignore" />
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- 보스 배너 — 가운데 위(윗줄 바로 아래). 보스가 나오면 뜨고 죽으면 잠시 뒤 사라진다.
		     모서리 깎은 남색 판(체력 게이지 + 번개 아이콘 브레이크 게이지) 위쪽 가운데에 탭(보스 아이콘 + 이름 + 레벨)이 걸치고,
		     무적·브레이크 기절 중에는 판 아래에 아이콘 칩으로 상태 설명이 뜬다 -->
		<ui:VisualElement name="boss" class="boss" picking-mode="Ignore">
			<ui:VisualElement class="boss__panel" picking-mode="Ignore">
				<ui:VisualElement name="boss-hp" class="boss__hp" picking-mode="Ignore">
					<ui:VisualElement name="boss-hp-fill" class="boss__hp-fill" picking-mode="Ignore" />
					<ui:Label name="boss-hp-text" class="boss__hp-text" picking-mode="Ignore" />
					<ui:Label name="boss-hp-percent" class="boss__percent" picking-mode="Ignore" />
				</ui:VisualElement>
				<ui:VisualElement name="boss-break-row" class="boss__break-row" picking-mode="Ignore">
					<ui:VisualElement class="boss__break-icon" picking-mode="Ignore" />
					<ui:VisualElement name="boss-break" class="boss__break" picking-mode="Ignore">
						<ui:VisualElement name="boss-break-fill" class="boss__break-fill" picking-mode="Ignore" />
					</ui:VisualElement>
				</ui:VisualElement>
			</ui:VisualElement>
			<!-- 탭은 판보다 뒤에 둬야 판 윗테두리를 덮는다 -->
			<ui:VisualElement class="boss__tab-row" picking-mode="Ignore">
				<ui:VisualElement class="boss__tab" picking-mode="Ignore">
					<ui:VisualElement class="boss__icon" picking-mode="Ignore" />
					<ui:Label name="boss-name" class="boss__name" picking-mode="Ignore" />
					<ui:Label name="boss-level" class="boss__level" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:VisualElement>
			<ui:VisualElement name="boss-state-chip" class="boss__state" picking-mode="Ignore">
				<ui:VisualElement class="boss__state-icon" picking-mode="Ignore" />
				<ui:Label name="boss-state" class="boss__state-text" picking-mode="Ignore" />
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- 궁극기 버튼 -->
		<!-- 칸(슬롯)째 숨긴다 — AUTO 칩이 원 밖으로 나오므로 버튼의 원형 클리핑 밖에 둔다 -->
		<ui:VisualElement name="ultimate-slot" class="ultimate-slot" picking-mode="Ignore">
			<!-- 임시 — 설정 화면이 생기면 그쪽으로 옮긴다 -->
			<ui:Button name="ultimate-auto-toggle" text="자동 전환" class="ultimate-slot__toggle hud-text" />
			<ui:Button name="ultimate" class="ultimate">
				<ui:VisualElement class="ultimate__face" picking-mode="Ignore">
					<ui:VisualElement name="ultimate-icon" class="ultimate__icon" picking-mode="Ignore" />
					<ui:VisualElement name="ultimate-cooltime" class="ultimate__cooltime" picking-mode="Ignore" />
					<ui:Label name="ultimate-time" class="ultimate__time hud-text" picking-mode="Ignore" />
				</ui:VisualElement>
			</ui:Button>
			<ui:Label name="ultimate-auto" text="AUTO" class="ultimate-slot__auto hud-text" picking-mode="Ignore" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
