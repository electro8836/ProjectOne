/* 메인 HUD — 기준 해상도 1080×1920. 배치는 모서리 기준 absolute.
   전환(translate·opacity)은 클래스로만 건다 — 코드는 클래스를 붙이고 뗄 뿐이다. */

.hud {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* 어두운 바탕 위 흰 글자 */
.hud-text {
	margin: 0;
	padding: 0;
	font-size: 36px;
	color: var(--white);
	-unity-text-outline-color: var(--ink);
	text-shadow: 0 3px 0 var(--ink);
}

/* ── 게이지 — 채움 폭은 코드가 % 로 쓴다 ───────────── */

.hud-gauge {
	height: 52px;
	background-color: #3C3050;
	border-width: 4px;
	border-color: #1E1C36;
}

.hud-gauge--thin {
	height: 20px;
	border-width: 3px;
}

.hud-gauge__fill {
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 0;
	background-color: #FF453D;
}

.hud-gauge__fill--break {
	background-color: #F1C220;
}

.hud-gauge__text {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 2px;
	-unity-text-align: middle-center;
}

/* ── 히어로 정보 — 레벨 원(지름 92, 테두리 고리가 경험치)이 체력바 왼쪽 끝을 덮는다.
   체력바(46) + 아래 전투력 탭(42, 6 겹침)을 합친 높이가 원 높이에 맞게 가운데 정렬 ── */

.hero-info {
	position: absolute;
	left: 20px;
	top: 24px;
	width: 426px;
	height: 92px;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

.hero-info .hud-text {
	-unity-text-outline-width: 0;
	text-shadow: 0 3px 0 #0A0814;
}

/* 원 중심(46)부터 시작 — 왼쪽 절반은 원 아래로 들어간다 */
.hero-info__bars {
	position: absolute;
	left: 46px;
	right: 0;
	top: 5px;
	height: 82px;
}

.hero-info .hud-gauge--hp {
	height: 46px;
	overflow: hidden;
	border-width: 3px;
	border-radius: 8px;
	border-color: #0A0814;
	background-color: rgba(10, 8, 20, 0.75);
}

/* 위쪽 밝은 띠로 입체감 */
.hero-info .hud-gauge__fill {
	background-color: #E8484E;
	border-top-width: 11px;
	border-color: #FF848A;
	border-top-right-radius: 5px;
	border-bottom-right-radius: 5px;
}

/* 수치는 원 오른쪽에 보이는 부분의 가운데 */
.hero-info__hp-text {
	left: 46px;
	font-size: 28px;
}

/* 전투력 탭 — 체력바 아래에 6px 숨어 들어가 붙는다 */
.hero-info__power {
	position: absolute;
	left: 30px;
	right: 0;
	top: 40px;
	height: 42px;
	padding: 6px 0 3px 30px;
	flex-direction: row;
	align-items: center;
	border-width: 0 3px 3px 3px;
	border-radius: 10px;
	border-color: #0A0814;
	background-color: #252A40;
}

.hero-info__power-icon {
	width: 24px;
	height: 22px;
	margin-right: 8px;
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Pictogram/PictoIcon_Attack.Png");
	-unity-background-image-tint-color: #FFD447;
	-unity-background-scale-mode: scale-to-fit;
}

.hero-info .hero-info__power-text {
	font-size: 24px;
	color: #FFD447;
	text-shadow: 0 2px 0 #0A0814;
}

/* 레벨 원 — 진한 원 위에 고리(HudHeroInfo 가 그린다), 안쪽 보라 원에 레벨 숫자 */
.hero-info__ring {
	position: absolute;
	left: 0;
	top: 0;
	width: 92px;
	height: 92px;
	border-radius: 46px;
	background-color: #0A0814;
	align-items: center;
	justify-content: center;
}

.hero-info__ring-core {
	width: 66px;
	height: 66px;
	border-width: 2px;
	border-radius: 33px;
	border-color: #0A0814;
	background-color: #322958;
	align-items: center;
	justify-content: center;
}

.hero-info__level {
	font-size: 33px;
	-unity-text-align: middle-center;
}

/* ── 맵 이름 ───────────────────────────────────── */

.map-info {
	position: absolute;
	right: 24px;
	top: 336px;	/* 오른쪽 위 미니맵 자리(메뉴 버튼 아래로 40px 띄운 144~324) 밑 */
	flex-direction: row;
	align-items: center;
}

.map-info__icon {
	width: 52px;
	height: 52px;
	margin-right: 8px;
	-unity-background-scale-mode: scale-to-fit;
}

/* ── 퀘스트 — 왼쪽 위(히어로 정보 아래). 보스 배너가 뜨면 숨는다(.hud--boss). 버튼이 카드 오른쪽에 붙는다.
   접으면 카드 폭(403)에서 버튼이 겹친 3px 을 뺀 만큼 왼쪽으로 밀어 버튼만 남긴다 ── */

.quest-info {
	position: absolute;
	left: -3px;
	top: 250px;
	flex-direction: row;
	align-items: center;
	transition-property: translate;
	transition-duration: 0.35s;
	transition-timing-function: ease-out-cubic;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

.quest-info--folded {
	translate: -400px 0;
}

/* 카드 — 왼쪽 테두리는 화면 밖(left -3) */
.quest-frame {
	width: 403px;
	height: 154px;
	padding: 10px 16px 0 21px;
	background-color: #1C2836;
	border-width: 3px;
	border-color: #0A0814;
	border-top-right-radius: 12px;
	border-bottom-right-radius: 12px;
}

.quest-frame__head {
	flex-direction: row;
	align-items: center;
	height: 32px;
}

.quest-frame__icon {
	width: 34px;
	height: 34px;
	margin-right: 4px;
	flex-shrink: 0;
	background-image: url("../../Violet/menuicon_quest.png");
	-unity-background-scale-mode: scale-to-fit;
	-unity-background-image-tint-color: #FFDC6E;
}

.quest-frame__title,
.quest-frame__desc,
.quest-frame__label,
.quest-frame__count {
	margin: 0;
	padding: 0;
	-unity-text-outline-width: 0;	/* :root 의 2px 외곽선을 끈다 — 20px 안팎 글자는 외곽선이 획을 먹어 가늘고 뭉개진다 */
	text-shadow: 0 2px 0 #0A0814;
}

.quest-frame__title {
	flex-shrink: 1;
	font-size: 26px;
	color: #FFDC6E;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/* 내용 — 최대 2줄, 넘치면 말줄임 */
.quest-frame__desc {
	height: 52px;
	margin-top: 4px;
	font-size: 20px;
	color: #E4EEF6;
	white-space: normal;
	overflow: hidden;
	text-overflow: ellipsis;
}

.quest-frame__progress {
	flex-direction: row;
	justify-content: space-between;
	margin-top: 6px;
}

.quest-frame__label {
	font-size: 19px;
	color: #FFFFFF;
}

.quest-frame__count {
	font-size: 19px;
	color: #FFFFFF;
}

.quest-frame__bar {
	height: 10px;
	margin-top: 4px;
	background-color: #0E1620;
	border-width: 2px;
	border-color: #0A0814;
	border-radius: 5px;
}

.quest-frame__fill {
	height: 100%;
	width: 0;
	background-color: #46BEF0;
	border-radius: 3px;
}

/* 접기 버튼 — 카드 오른쪽 테두리에 3px 겹쳐 붙는다. 펼침이면 꺾쇠가 왼쪽(접는 쪽) */
.quest-tab,
.quest-tab:hover:enabled,
.quest-tab:disabled {
	margin: 0 0 0 -3px;
	padding: 0;
	width: 64px;
	height: 110px;
	opacity: 1;
	background-color: #2C3E52;
	border-width: 3px;
	border-color: #0A0814;
	border-radius: 10px;
	align-items: center;
	justify-content: center;
}

.quest-tab__arrow {
	width: 28px;
	height: 40px;
	background-image: url("../../Violet/icon_chevron.png");
	-unity-background-scale-mode: scale-to-fit;
	rotate: 180deg;
}

.quest-info--folded .quest-tab__arrow {
	rotate: 0deg;
}

/* 목표 달성 — 카드 테두리·게이지, 버튼 바탕·테두리가 초록. 글자색은 그대로 */
.quest-info--met .quest-frame {
	border-color: #5CF08C;
	border-width: 4px;
	padding: 9px 15px 0 20px;
}

.quest-info--met .quest-frame__fill {
	background-color: #5CF08C;
}

.quest-info--met .quest-tab,
.quest-info--met .quest-tab:hover:enabled,
.quest-info--met .quest-tab:disabled {
	background-color: #38BE6E;
	border-color: #5CF08C;
}

/* ── 버프 ──────────────────────────────────────── */

.buff-list {
	position: absolute;
	left: 15px;
	top: 600px;
	width: 75px;
	flex-direction: column;
}

/* 버프 1칸 — 75×75 둥근 칸. 검은 바탕 + 초록 테두리 3px, 아이콘은 테두리 안쪽을 채운다 */
.buff {
	width: 75px;
	height: 75px;
	margin-bottom: 15px;
	background-color: #000000;
	border-width: 3px;
	border-color: #42FF49;
	border-radius: 10px;
}

.buff__icon {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	border-radius: 7px;
	-unity-background-scale-mode: scale-to-fit;
}

/* 중첩 수 — 칸 윗변에 걸쳐 가운데. 남은 시간과 같은 만큼(10px)만 내민다 — 더 내밀면 위 칸의 남은 시간과 겹친다 */
.buff__stack {
	position: absolute;
	left: -10px;
	right: -10px;
	top: -10px;
	font-size: 28px;
	-unity-text-align: upper-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

/* 남은 시간 — 칸 아랫변에 걸쳐 가운데 */
.buff__time {
	position: absolute;
	left: -10px;
	right: -10px;
	bottom: -10px;
	font-size: 28px;
	-unity-text-align: lower-center;
	white-space: nowrap;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

/* ── 오른쪽 위: 재화 + 메뉴 — 왼쪽 위 전투력 탭과 같은 남색 판(#252A40) + 진한 테두리.
   세로 가운데를 히어로 정보 원 중심과 맞춘다 ── */

.top-right {
	position: absolute;
	right: 20px;
	top: 28px;
	flex-direction: row;
	align-items: center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

.resource {
	flex-direction: row;
	align-items: center;
	width: 184px;
	height: 56px;
	margin-right: 12px;
	padding: 0 14px 0 10px;
	background-color: #252A40;
	border-width: 3px;
	border-radius: 10px;
	border-color: #0A0814;
}

.resource__icon {
	width: 40px;
	height: 40px;
	-unity-background-scale-mode: scale-to-fit;
}

.resource__text {
	flex-grow: 1;
	font-size: 30px;
	-unity-text-align: middle-right;
	-unity-text-outline-width: 0;
	text-shadow: 0 3px 0 #0A0814;
}

.menu-button {
	margin: 0;
	padding: 0;
	width: 76px;
	height: 76px;
	border-width: 3px;
	border-radius: 12px;
	border-color: #0A0814;
	background-color: #252A40;
	align-items: center;
	justify-content: center;
}

.menu-button:hover:enabled {
	background-color: #252A40;
	border-color: #0A0814;
}

.menu-button:active {
	translate: 0 4px;
}

/* 원본 128px 안 그림은 90x76 — 그림 높이가 34px 가 되게 칸을 키운다 */
.menu-button__icon {
	width: 58px;
	height: 58px;
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Pictogram/PictoIcon_Menu.Png");
	-unity-background-scale-mode: scale-to-fit;
}

.hud-badge {
	position: absolute;
	right: -6px;
	top: -6px;
	width: 36px;
	height: 36px;
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Buttons/Alert_Dot_Red.png");
	-unity-background-scale-mode: scale-to-fit;
	display: none;
}

.hud-badge--on {
	display: flex;
}

/* ── 보스 배너 ─────────────────────────────────── */

/* 가운데 위 — 윗줄(히어로 정보·재화, ~116px) 바로 아래. 높이는 상태 글까지 ~188px(130~318).
   떠 있는 동안 HUD 루트에 hud--boss 가 붙어 미니맵·퀘스트가 숨는다 */
.boss {
	position: absolute;
	left: 220px;
	right: 220px;
	top: 130px;
	align-items: stretch;
	display: none;
	opacity: 1;
}

.boss--shown {
	display: flex;
}

/* 보스 배너 자리를 쓰는 동안 숨기는 것들 — 미니맵(지금은 맵 이름)·퀘스트. 입력도 받지 않는다 */
.hud--boss .map-info,
.hud--boss .quest-info {
	visibility: hidden;
}

/* 사망 뒤 사라짐 — 시간은 BossUI 가 잰다 */
.boss--fading {
	opacity: 0;
	transition-property: opacity;
	transition-duration: 1s;
}

.boss__name-row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 6px;
}

.boss__name {
	flex-grow: 1;
	flex-shrink: 1;
	overflow: hidden;
}

.boss__icon {
	width: 48px;
	height: 48px;
	margin-right: 8px;
	background-image: url("../../../Art/UI/Atlas/Textures/Common/Pictogram/PictoIcon_Boss.Png");
	-unity-background-scale-mode: scale-to-fit;
}

.hud-gauge--boss {
	height: 60px;
}

/* 게이지 안 — 수치는 왼쪽, 퍼센트는 오른쪽 */
.boss__hp-text {
	left: 12px;
	-unity-text-align: middle-left;
}

.boss__percent {
	right: 12px;
	left: auto;
	-unity-text-align: middle-right;
}

.hud-gauge--immune {
	border-color: #FFFFFF;
}

.hud-gauge--immune .hud-gauge__fill {
	background-color: #40E7FF;
}

.hud-gauge--stun {
	border-color: #FFFFFF;
}

.boss .hud-gauge--thin {
	margin-top: 4px;
}

.boss__state {
	margin-top: 6px;
	-unity-text-align: middle-center;
	color: #40E7FF;
}

/* ── 궁극기 버튼 ───────────────────────────────── */

.ultimate {
	position: absolute;
	right: 50px;
	bottom: 640px;
	margin: 0;
	padding: 4px;
	width: 136px;
	height: 136px;
	border-width: 6px;
	border-radius: 68px;
	border-color: #000000;
	background-color: #FFFFFF;
	overflow: hidden;
	display: none;
}

.ultimate:hover:enabled {
	background-color: #FFFFFF;
	border-color: #000000;
}

.ultimate:active {
	scale: 0.95 0.95;
}

.ultimate--shown {
	display: flex;
}

.ultimate__icon {
	flex-grow: 1;
	border-radius: 60px;
	-unity-background-scale-mode: scale-and-crop;
}

.ultimate__cooltime {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	border-radius: 68px;
	background-color: rgba(0, 0, 0, 0.78);
	align-items: center;
	justify-content: center;
	display: none;
}

.ultimate--cooling .ultimate__cooltime {
	display: flex;
}

.ultimate__time {
	font-size: 48px;
}
