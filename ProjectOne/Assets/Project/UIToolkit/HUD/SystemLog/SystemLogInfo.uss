/* 획득 로그 — 첫 번째 자식이 맨 아래(column-reverse). 코드는 새 줄을 0번에 꽂는다.
   줄마다 남색 띠(알파 235, 60% 지점부터 오른쪽 끝까지 smoothstep 으로 옅어짐 — 꺾이는 경계가 보이지 않게) + 왼쪽 보라 줄. 줄 사이 틈 없이 붙인다. */

.syslog-layer {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

.syslog {
	position: absolute;
	left: 0;
	bottom: 280px;
	width: 500px;
	flex-direction: column-reverse;
}

.syslog__line {
	min-height: 46px;
	margin: 0;
	padding: 4px 20px 4px 16px;
	background-image: url("../../Violet/syslog_band.png");
	-unity-background-scale-mode: stretch-to-fill;
	border-left-width: 4px;
	border-left-color: #6E5CAA;
	font-size: 30px;
	color: var(--white);
	white-space: normal;
	-unity-text-align: middle-left;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
	-unity-text-outline-width: 0;
	text-shadow: 0 2px 0 var(--ink);
}
