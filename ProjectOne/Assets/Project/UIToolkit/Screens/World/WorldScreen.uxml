<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="WorldScreen.uss" />

	<ui:VisualElement name="screen" class="screen">
		<ui:VisualElement class="px-wood header">
			<ui:Label text="월드" class="header__title text-pop" />
			<ui:Button name="home-button" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
		</ui:VisualElement>

		<!-- 현재 월드 — 누르면 구역 목록 팝업 -->
		<ui:VisualElement name="act" class="px-paper world-card">
			<ui:VisualElement class="world-card__icon-frame">
				<ui:VisualElement name="act-icon" class="icon" picking-mode="Ignore" />
			</ui:VisualElement>
			<ui:VisualElement class="world-card__body" picking-mode="Ignore">
				<ui:Label name="act-name" text="" class="world-card__name" picking-mode="Ignore" />
				<ui:Label name="location" text="" class="world-card__location" picking-mode="Ignore" />
				<ui:VisualElement class="gauge gauge--gold world-card__gauge" picking-mode="Ignore">
					<ui:VisualElement name="progress-fill" class="gauge__fill" picking-mode="Ignore" />
					<ui:Label name="progress-text" text="" class="gauge__text" picking-mode="Ignore" />
				</ui:VisualElement>
				<ui:Label text="눌러서 구역 보기" class="world-card__hint" picking-mode="Ignore" />
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- 던전 -->
		<ui:Label text="던전" class="section-title world-section" />
		<ui:VisualElement class="world-dungeons">
			<ui:Button name="dungeon-gold" text="골드 던전" class="btn btn--gold world-dungeon" />
			<ui:Button name="dungeon-rift" text="균열 던전" class="btn btn--purple world-dungeon" />
			<ui:Button name="dungeon-labyrinth" text="미궁 던전" class="btn world-dungeon" />
			<ui:Button name="dungeon-ruins" text="유적 던전" class="btn btn--orange world-dungeon" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
