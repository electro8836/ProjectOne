<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="CostumeScreen.uss" />

	<ui:VisualElement name="screen" class="screen screen--full">
		<ui:VisualElement class="px-wood header">
			<ui:Label text="코스튬" class="header__title text-pop" />
			<ui:Button name="return-button" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
		</ui:VisualElement>

		<!-- 입어보기 결과 -->
		<ui:VisualElement class="px-paper costume-stage">
			<ui:VisualElement name="character" class="costume-stage__character" picking-mode="Ignore" />
		</ui:VisualElement>

		<ui:VisualElement class="tabs">
			<ui:Button name="tab-0" text="무기" class="tab" />
			<ui:Button name="tab-1" text="의상" class="tab" />
		</ui:VisualElement>

		<ui:VisualElement class="px-paper sheet">
			<ui:ScrollView name="list" class="costume-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
