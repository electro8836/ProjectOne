<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="CostumeScreen.uss" />

	<ui:VisualElement name="screen" class="screen screen--full theme-violet costume">
		<!-- 제목 판: 장비·제작과 같은 보라 판. 네비게이션 바를 가리는 화면이라 닫기 X 를 둔다 -->
		<ui:VisualElement class="header">
			<ui:VisualElement class="header__frame">
				<ui:VisualElement class="header__wash" picking-mode="Ignore" />
				<ui:Label text="코스튬" class="header__title text-pop" />
				<ui:Button name="return-button" text="" class="btn btn--icon costume-close"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- 입어보기 결과 -->
		<ui:VisualElement class="costume-stage">
			<ui:VisualElement class="header-shadow" picking-mode="Ignore" />
			<ui:VisualElement class="costume-stage__glow" picking-mode="Ignore" />
			<ui:VisualElement name="character" class="costume-stage__character" picking-mode="Ignore" />
		</ui:VisualElement>

		<!-- 무기/의상 탭 — 제작 모드 탭과 같은 어두운 홈 + 선택 칸만 밝게 -->
		<ui:VisualElement class="costume-seg">
			<ui:Button name="tab-0" text="무기" class="costume-seg__item" />
			<ui:Button name="tab-1" text="의상" class="costume-seg__item" />
		</ui:VisualElement>

		<ui:ScrollView name="list" class="costume-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
	</ui:VisualElement>
</ui:UXML>
