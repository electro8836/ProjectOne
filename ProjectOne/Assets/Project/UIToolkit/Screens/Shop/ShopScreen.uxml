<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="ShopScreen.uss" />

	<ui:VisualElement name="screen" class="screen">
		<ui:VisualElement class="px-wood header">
			<ui:Label text="상점" class="header__title text-pop" />
			<ui:Button name="home-button" text="" class="btn btn--red btn--icon"><ui:VisualElement class="icon-close" picking-mode="Ignore" /></ui:Button>
		</ui:VisualElement>

		<!-- 탭은 ShopCategory 수만큼 코드가 만든다 -->
		<ui:VisualElement name="tabs" class="tabs" />

		<ui:VisualElement class="px-paper sheet">
			<ui:ScrollView name="list" class="shop-list" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
