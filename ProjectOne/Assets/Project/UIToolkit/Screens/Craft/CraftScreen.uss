/* 제작 화면 — 바이올렛 (기준 해상도 1080 x 1920, 세로). 제목 판·분류 탭·가방·아이템 칸은 Violet.uss 를 따른다.
   위 작업대는 장비 화면 위 영역과 같은 면(#252A40). 모드 탭은 색 없이 밝은 칸만 움직이고,
   모드 색(재련 보라 · 강화 초록 · 승급 금 · 전이 파랑)은 빛·화살표·실행 버튼에만 쓴다 — 루트의 craft--mode-N 이 고른다.
   제작 모드는 등록 칸·장비 목록 대신 조합법 트리(forge-*)·조합법 목록(recipe-*)을 보인다. */

.craft {
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

/* 가방만 늘고 줄어든다 — 나머지는 내용보다 작아지지 않게(UI Toolkit 기본 flex-shrink 는 1) */
.craft .header,
.craft-work,
.craft .tabs,
.craft .bag__toolbar,
.forge-stage {
	flex-shrink: 0;
}

/* ── 작업대 ─────────────────────────────────────── */

.craft-work {
	margin: 0 -6px;
	padding: 26px 6px 28px 6px;
	background-color: #252A40;
}

/* 등록 칸 뒤 빛 — 흰 빛(glow_white)을 모드 색으로 틴트 */
.craft-glow {
	position: absolute;
	left: 170px;
	right: 170px;
	top: 60px;
	height: 560px;
	background-image: url("../../Violet/glow_white.png");
	-unity-background-scale-mode: stretch-to-fill;
	opacity: 0.8;
}

/* 모드 탭 — 어두운 홈 하나 + 선택 칸만 밝은 판 */
.craft-seg {
	flex-direction: row;
	height: 94px;
	margin: 0 18px;
	padding: 6px;
	border-width: 3px;
	border-color: #2E3450;
	border-radius: 26px;
	background-color: #151826;
}

.craft-seg__item {
	flex-grow: 1;
	flex-basis: 0;
	margin: 0;
	padding: 0;
	border-width: 0;
	border-radius: 20px;
	background-color: rgba(0, 0, 0, 0);
	background-image: none;
	font-size: 40px;
	color: #8E93B8;
	text-shadow: 0 0 0 rgba(0, 0, 0, 0);
	-unity-text-align: middle-center;
}

.craft-seg__item--on {
	background-color: #3D4566;
	color: #FFFFFF;
	text-shadow: 0 3px 0 #0A0814;
}

/* 모드별 등록 칸 줄 */
.craft-panel {
	display: none;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 240px;
	margin-top: 40px;
}

.craft-panel--shown {
	display: flex;
}

/* 등록 칸 — 아이템 칸과 같은 둥근 틀(slot_round)·크기라 장비를 올려도 모서리가 어긋나지 않는다 */
.craft-slot {
	width: 240px;
	height: 240px;
	align-items: center;
	justify-content: center;
	background-image: url("../../Violet/slot_round.png");
	-unity-slice-left: 32;
	-unity-slice-right: 32;
	-unity-slice-top: 32;
	-unity-slice-bottom: 32;
	-unity-slice-scale: 1px;
	-unity-background-image-tint-color: #5C6390;
	border-radius: 24px;
	background-color: #191C2C;	/* 틀 안쪽이 비쳐 뒤의 빛이 보이지 않게 — 빈 칸은 어두운 면 */
	transition-property: scale;
	transition-duration: 0.3s;
	transition-timing-function: ease-out-back;
}

.craft-slot--pop {
	scale: 1.3 1.3;
	transition-duration: 0s;
}

/* 승급 후 미리보기 — 칸(틀·어두운 면)은 그대로 두고 올린 장비만 살짝 흐리게(칸째 흐리면 뒤의 빛이 비쳐 뚫려 보인다) */
.craft-slot--preview .item-cell {
	opacity: 0.85;
}

.craft-slot__hint {
	margin-bottom: 5px;	/* 틀 아랫변이 두꺼워(15px) 안쪽 가운데가 위로 올라가 있다 */
	font-size: 34px;
	color: #8E93B8;
	text-shadow: 0 0 0 rgba(0, 0, 0, 0);
	white-space: normal;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-SemiBold.ttf");
}

.craft-slot .item-cell {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* 칸 사이 화살표 — 모드 색 틴트 */
.craft-arrow {
	width: 64px;
	height: 76px;
	margin: 0 64px;
	background-image: url("../../Violet/icon_arrow.png");
	-unity-background-scale-mode: scale-to-fit;
}

/* 재료 띠 — 어두운 둥근 띠 하나에 아이콘 x수량, 또는 불가 문구 */
.craft-cost {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 86px;
	margin: 40px 114px 0 114px;
	padding: 0 24px;
	border-width: 3px;
	border-color: #2E3450;
	border-radius: 43px;
	background-color: #121420;
}

.craft-cost__row {
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.craft .cost {
	margin: 0 22px;
}

.craft .cost__icon {
	width: 64px;
	height: 64px;
	margin-right: 10px;
}

.craft .cost__count {
	font-size: 38px;
	color: #FFFFFF;
}

.craft-cost__disable {
	font-size: 34px;
	color: #FF8A80;
	white-space: normal;
	-unity-text-align: middle-center;
}

/* 버튼 줄 — 취소(빨강)와 실행(모드 색)을 같은 폭으로. 구운 버튼 높이 112px 그대로 쓴다 */
.craft-buttons {
	flex-direction: row;
	justify-content: center;
	margin-top: 36px;
	padding: 0 34px;
}

.craft .craft-button {
	flex-grow: 1;
	flex-basis: 0;
	height: 112px;
	margin: 0 16px;
	font-size: 48px;
	color: #FFFFFF;
	-unity-text-outline-width: 2px;
	-unity-font-style: bold;
}

.craft .craft-button.btn--red {
	background-image: url("../../Violet/btn_danger_large.png");
}

/* ── 모드 색 — 0 제작 · 1 재련 · 2 강화 · 3 승급 · 4 전이 (CraftMode 순서) ── */

.craft--mode-0 .craft-glow {
	-unity-background-image-tint-color: #A070FF;
}

.craft--mode-1 .craft-glow,
.craft--mode-1 .craft-arrow {
	-unity-background-image-tint-color: #B478FF;
}

.craft--mode-1 .craft-action {
	background-image: url("../../Violet/btn_face_large.png");
}

.craft--mode-2 .craft-glow,
.craft--mode-2 .craft-arrow {
	-unity-background-image-tint-color: #3CBE6E;
}

.craft--mode-2 .craft-action {
	background-image: url("../../Violet/btn_active_large.png");
}

.craft--mode-3 .craft-glow,
.craft--mode-3 .craft-arrow {
	-unity-background-image-tint-color: #F0AA32;
}

.craft--mode-3 .craft-action {
	background-image: url("../../Violet/btn_gold_large.png");
}

.craft--mode-4 .craft-glow,
.craft--mode-4 .craft-arrow {
	-unity-background-image-tint-color: #508CFF;
}

.craft--mode-4 .craft-action {
	background-image: url("../../Violet/btn_blue_large.png");
}

/* ── 모드별로 보일 영역 — 제작 모드는 조합법 트리·목록, 나머지는 등록 칸·장비 목록 ── */

.forge-only {
	display: none;
}

.craft--mode-0 .forge-only {
	display: flex;
}

.craft--mode-0 .equip-only {
	display: none;
}

.reforge-info {
	display: none;
	margin-top: 22px;
	font-size: 34px;
	color: #CED3FB;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-SemiBold.ttf");
}

.craft--mode-1 .reforge-info {
	display: flex;
}

/* ── 분류 탭 (모양은 Violet.uss) ───────────────────── */

.craft .tab {
	height: 92px;
	font-size: 36px;
	align-items: center;
	justify-content: center;
}

.craft .tab__icon {
	-unity-background-scale-mode: scale-to-fit;
}

/* ── 장비 목록 (면·칸 크기는 Violet.uss) ─────────────── */

.craft .bag {
	flex-grow: 1;
	flex-shrink: 1;
	padding-top: 22px;
	padding-bottom: 26px;
}

.craft .bag__toolbar {
	flex-direction: row;
	align-items: center;
	margin-bottom: 8px;
}

.craft .bag__caption {
	margin: 0 12px 0 6px;
}

.craft .bag__capacity {
	flex-grow: 1;
}

.craft .bag__button {
	min-width: 150px;
	margin-left: 10px;
}

.craft .item-grid {
	flex-grow: 1;
	flex-shrink: 1;
}

.craft .item-grid .unity-scroll-view__content-container {
	flex-direction: row;
	flex-wrap: wrap;
}

/* ── 제작: 조합법 트리 ───────────────────────────── */

.forge-stage {
	align-items: center;
	margin-top: 26px;
	padding-bottom: 6px;
}

/* 아이템 칸 상자 — 칸(ItemCellView)은 상자를 꽉 채운다. 보유량·체크는 칸 위에 얹는다 */
.forge-cell {
	width: 150px;
	height: 150px;
}

.forge-cell .item-cell {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	margin: 0;
	width: auto;
	height: auto;
}

.forge-cell--result {
	width: 200px;
	height: 200px;
	transition-property: scale;
	transition-duration: 0.3s;
	transition-timing-function: ease-out-back;
}

.forge-branch {
	left: 95px;
	right: 95px;
}

/* 결과 칸 뒤 금색 선택 빛 */
.forge-cell--result .item-cell {
	border-width: 4px;
	border-color: #F0C850;
	border-radius: 28px;
}

.forge-cell--sub {
	width: 108px;
	height: 108px;
}

/* 모자란 재료 — 빨간 테두리 */
.forge-cell__short {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	border-width: 5px;
	border-color: #FF6060;
	border-radius: 24px;
	display: none;
}

.forge-mat--short .forge-cell__short {
	display: flex;
}

/* 보유량/필요량 — 칸 아래쪽 가운데 */
.forge-count {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 10px;
	margin: 0;
	font-size: 28px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	text-shadow: 0 2px 0 #0A0814;
}

.forge-mat--short .forge-count {
	color: #FF6060;
}

.forge-cell--sub .forge-count {
	font-size: 22px;
	bottom: 4px;
}

/* 보유한 이전 장비 — 오른쪽 위 초록 체크 */
.forge-check {
	position: absolute;
	right: -8px;
	top: -8px;
	width: 44px;
	height: 44px;
	border-width: 4px;
	border-color: #0A0814;
	border-radius: 22px;
	background-color: #3CBE6E;
	font-size: 26px;
	color: #FFFFFF;
	-unity-text-align: middle-center;
	display: none;
}

.forge-mat--owned .forge-check {
	display: flex;
}

/* 이름 글자 */
.forge-name {
	margin: 8px 0 0 0;
	font-size: 28px;
	color: #CED3FB;
	-unity-text-align: upper-center;
	white-space: nowrap;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-SemiBold.ttf");
}

.forge-name--result {
	margin-top: 10px;
	font-size: 38px;
	color: #FFFFFF;
	text-shadow: 0 3px 0 #0A0814;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-ExtraBold.ttf");
}

.forge-mat--short .forge-name {
	color: #FF6060;
}

/* 결과 → 재료 줄 ㄱ자 연결선 */
.forge-trunk {
	width: 6px;
	height: 28px;
	background-color: #5C6496;
}

.forge-mats {
	flex-direction: row;
	justify-content: center;
	padding-top: 24px;
}

.forge-branch {
	position: absolute;
	top: 0;
	height: 6px;
	background-color: #5C6496;
}

.forge-mat {
	width: 190px;
	align-items: center;
}

/* 칸 위로 가로선까지 올라가는 짧은 선 */
.forge-mat__stub {
	position: absolute;
	top: -24px;
	width: 6px;
	height: 24px;
	background-color: #5C6496;
}

/* 하위 재료 한 층 — 칸들 + 금색 조합 버튼. 없을 때도 자리는 남긴다(visibility) */
.forge-sub {
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 160px;
	margin-top: 12px;
}

.forge-sub__cells {
	flex-direction: row;
	align-items: flex-start;
}

.forge-sub .forge-mat {
	width: 180px;
}

.forge-sub .forge-name {
	width: 176px;
	font-size: 22px;
	white-space: normal;
}

/* 테마의 .theme-violet .btn 보다 늦게 오도록 .craft 를 붙인다 */
.craft .forge-sub__button {
	width: 140px;
	height: 72px;
	margin-left: 20px;
	padding: 0;
	background-image: url("../../Violet/btn_gold_large.png");
	font-size: 32px;
	color: #FFFFFF;
	-unity-text-outline-width: 2px;
}

/* 제작하기 — 연두 큰 버튼 안 두 줄(제목 + 성공 확률) */
.craft .forge-action {
	width: 480px;
	height: 128px;
	margin-top: 8px;
	padding: 0;
	align-items: center;
	justify-content: center;
	background-image: url("../../Violet/btn_enchant.png");
	-unity-slice-left: 30;
	-unity-slice-right: 30;
	-unity-slice-top: 0;
	-unity-slice-bottom: 0;
	-unity-slice-scale: 1px;
}

.forge-action__title {
	margin: 0;
	font-size: 48px;
	color: #FFFFFF;
	-unity-text-outline-width: 2px;
	-unity-text-align: middle-center;
}

.forge-action__rate {
	margin: 0;
	font-size: 28px;
	color: #F4FFE0;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-SemiBold.ttf");
}

.forge-hint {
	margin-top: 10px;
	font-size: 26px;
	color: #8E93B8;
	-unity-text-align: middle-center;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-SemiBold.ttf");
}

.forge-empty {
	position: absolute;
	left: 0;
	right: 0;
	top: 220px;
	font-size: 36px;
	color: #8E93B8;
	-unity-text-align: middle-center;
	display: none;
}

.forge-stage--empty > * {
	visibility: hidden;
}

.forge-stage--empty .forge-empty {
	visibility: visible;
	display: flex;
}

/* ── 제작: 조합법 목록 ───────────────────────────── */

.recipe-tab {
	flex-grow: 1;
	flex-basis: 0;
	font-size: 36px;
}

.craft .recipe-bag {
	padding-top: 18px;
}

.recipe-list {
	flex-grow: 1;
	flex-shrink: 1;
}

.recipe-row {
	flex-direction: row;
	align-items: center;
	height: 140px;
	margin-bottom: 12px;
	padding: 0 20px 0 14px;
	border-width: 4px;
	border-color: rgba(0, 0, 0, 0);
	border-radius: 22px;
	background-color: #2B2550;
}

.recipe-row--selected {
	border-color: #F0C850;
}

.recipe-row .forge-cell {
	width: 112px;
	height: 112px;
}

/* 작은 칸(112px) — 틀·배지·아이콘 여백이 196px 칸 기준 고정값이라, 196px 로 그린 뒤 통째로 줄인다(112 / 196) */
.recipe-row .forge-cell .item-cell {
	left: 0;
	top: 0;
	right: auto;
	bottom: auto;
	width: 196px;
	height: 196px;
	transform-origin: left top;
	scale: 0.5714 0.5714;
}

/* 줄인 뒤 티어 배지 글자 18px · 위로 10px 튀어나오게(줄 안쪽 위 여백 14px 안) */
.craft .recipe-row .item-cell__tier {
	top: -18px;
	padding: 0 14px 0 14px;
	border-width: 3.5px;
	font-size: 32px;
}

.recipe-row__texts {
	flex-grow: 1;
	margin-left: 22px;
}

.recipe-row__name {
	margin: 0;
	font-size: 38px;
	color: #FFFFFF;
	text-shadow: 0 3px 0 #0A0814;
}

.recipe-row__sub {
	margin: 4px 0 0 0;
	font-size: 28px;
	color: #A8A2CC;
	-unity-font-definition: url("../../../Art/UI/Fonts/Pretendard/Pretendard-SemiBold.ttf");
}

/* 상태 알약 */
.recipe-pill {
	min-width: 150px;
	height: 54px;
	margin: 0;
	padding: 0 18px;
	border-radius: 27px;
	background-color: #14121F;
	font-size: 28px;
	color: #9A97B8;
	-unity-text-align: middle-center;
}

.recipe-pill--ok {
	color: #7CF08A;
}

.recipe-pill--short {
	color: #FF6060;
}

/* ── 제작: 보유 재료 버튼 — 결과 칸 오른쪽 위 둥근 버튼 ── */

/* 둥근 어두운 판 + 보라 테두리, 가운데 재료 아이콘, 아래 '재료' 알약이 테두리에 걸친다.
   .btn 의 최소 폭·면 그림을 끈다 */
.theme-violet .btn.forge-material-button {
	position: absolute;
	top: 0;
	right: 40px;
	width: 104px;
	height: 104px;
	min-width: 0;
	padding: 0;
	margin: 0;
	border-width: 5px;
	border-color: #8C76E6;
	border-radius: 52px;
	background-image: none;
	background-color: #221C3E;
	align-items: center;
	justify-content: center;
}

.theme-violet .btn.forge-material-button:active {
	background-color: #18142C;
}

.forge-material-button__icon {
	width: 64px;
	height: 64px;
	margin-bottom: 8px;
	background-image: url("../../../Art/UI/Atlas/Textures/Icons/Items/ItemIcon_Key_03.png");
	-unity-background-scale-mode: scale-to-fit;
}

.forge-material-button__text {
	position: absolute;
	bottom: -18px;
	margin: 0;
	padding: 0 14px 2px 14px;
	border-radius: 14px;
	background-color: #141024;
	font-size: 24px;
	color: #FFFFFF;
	text-shadow: 0 2px 0 #0A0814;
}

/* 조합법을 안 골라도 보인다 */
.forge-stage--empty .forge-material-button {
	visibility: visible;
}
