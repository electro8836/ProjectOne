<ui:UXML xmlns:ui="UnityEngine.UIElements">
	<Style src="../../Common/Theme.uss" />
	<Style src="../../Common/Violet.uss" />
	<Style src="CraftScreen.uss" />

	<!-- CraftUI.ShowMode 가 루트에 붙이는 모드 클래스가 모드 색(빛·화살표·실행 버튼)을 고른다 -->
	<ui:VisualElement name="screen" class="screen theme-violet craft">

		<!-- 제목 판: 장비·상점과 같은 보라 판 + 재화 (닫기는 네비게이션 바 탭을 다시 누른다) -->
		<ui:VisualElement class="header">
			<ui:VisualElement class="header__frame">
				<ui:VisualElement class="header__wash" picking-mode="Ignore" />
				<ui:Label text="제작" class="header__title text-pop" />
				<!-- 재화 캡슐 최대 3칸 — 보일 재화는 CraftUI 의 _headerCurrencies 가 정하고, 남는 칸은 숨긴다 -->
				<ui:VisualElement name="header-currencies" class="header__currencies">
					<ui:VisualElement name="currency-0" class="currency-capsule"><ui:VisualElement class="currency-capsule__icon" picking-mode="Ignore" /><ui:Label text="" class="currency-capsule__text" picking-mode="Ignore" /></ui:VisualElement>
					<ui:VisualElement name="currency-1" class="currency-capsule"><ui:VisualElement class="currency-capsule__icon" picking-mode="Ignore" /><ui:Label text="" class="currency-capsule__text" picking-mode="Ignore" /></ui:VisualElement>
					<ui:VisualElement name="currency-2" class="currency-capsule"><ui:VisualElement class="currency-capsule__icon" picking-mode="Ignore" /><ui:Label text="" class="currency-capsule__text" picking-mode="Ignore" /></ui:VisualElement>
				</ui:VisualElement>
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- 작업대: 모드 탭 · 등록 칸 · 재료 띠 · 버튼 -->
		<ui:VisualElement class="craft-work">
			<ui:VisualElement class="header-shadow" picking-mode="Ignore" />
			<ui:VisualElement class="craft-glow" picking-mode="Ignore" />

			<!-- 모드 탭 — 어두운 홈 하나에 선택 칸만 밝게(색은 실행 버튼에만) -->
			<ui:VisualElement class="craft-seg">
				<ui:Button name="mode-0" text="강화" class="craft-seg__item" />
				<ui:Button name="mode-1" text="승급" class="craft-seg__item" />
				<ui:Button name="mode-2" text="전이" class="craft-seg__item" />
			</ui:VisualElement>

			<!-- 강화: 칸 하나 -->
			<ui:VisualElement name="panel-0" class="craft-panel">
				<ui:VisualElement name="slot-enhance" class="craft-slot"><ui:Label text="장비 선택" class="craft-slot__hint" picking-mode="Ignore" /></ui:VisualElement>
			</ui:VisualElement>

			<!-- 승급: 현재 → 승급 후 -->
			<ui:VisualElement name="panel-1" class="craft-panel">
				<ui:VisualElement name="slot-promote-prev" class="craft-slot"><ui:Label text="장비 선택" class="craft-slot__hint" picking-mode="Ignore" /></ui:VisualElement>
				<ui:VisualElement class="craft-arrow" picking-mode="Ignore" />
				<ui:VisualElement name="slot-promote-next" class="craft-slot craft-slot--preview"><ui:Label text="승급 후" class="craft-slot__hint" picking-mode="Ignore" /></ui:VisualElement>
			</ui:VisualElement>

			<!-- 전이: 재료 → 대상 -->
			<ui:VisualElement name="panel-2" class="craft-panel">
				<ui:VisualElement name="slot-transfer-source" class="craft-slot"><ui:Label text="재료 장비" class="craft-slot__hint" picking-mode="Ignore" /></ui:VisualElement>
				<ui:VisualElement class="craft-arrow" picking-mode="Ignore" />
				<ui:VisualElement name="slot-transfer-target" class="craft-slot"><ui:Label text="대상 장비" class="craft-slot__hint" picking-mode="Ignore" /></ui:VisualElement>
			</ui:VisualElement>

			<!-- 재료 띠 (모드 공용) — 재료 또는 불가 문구. 등록한 것이 없으면 자리만 남기고 숨긴다 -->
			<ui:VisualElement name="requirement" class="craft-cost">
				<ui:VisualElement name="cost-row" class="craft-cost__row" />
				<ui:Label name="disable-text" text="" class="craft-cost__disable" />
			</ui:VisualElement>

			<ui:VisualElement class="craft-buttons">
				<ui:Button name="cancel-button" text="취소" class="btn btn--red craft-button" />
				<ui:Button name="action-button" text="강화하기" class="btn craft-button craft-action" />
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- 분류 탭 (전체는 글자, 나머지는 분류 아이콘) -->
		<ui:VisualElement class="tabs">
			<ui:Button name="filter-0" text="전체" class="tab" />
			<ui:Button name="filter-1" text="" class="tab"><ui:VisualElement class="tab__icon type-weapon" picking-mode="Ignore" /></ui:Button>
			<ui:Button name="filter-2" text="" class="tab"><ui:VisualElement class="tab__icon type-armor" picking-mode="Ignore" /></ui:Button>
			<ui:Button name="filter-3" text="" class="tab"><ui:VisualElement class="tab__icon type-accessory" picking-mode="Ignore" /></ui:Button>
			<ui:Button name="filter-4" text="" class="tab"><ui:VisualElement class="tab__icon type-relic" picking-mode="Ignore" /></ui:Button>
		</ui:VisualElement>

		<!-- 장비 목록 -->
		<ui:VisualElement class="px-paper bag">
			<ui:VisualElement class="bag__toolbar">
				<ui:Label text="장비" class="bag__caption" />
				<ui:Label name="count" text="" class="bag__capacity" />
				<ui:Button name="sort-button" text="" class="btn btn--small btn--gold bag__button" />
			</ui:VisualElement>
			<ui:ScrollView name="grid" class="item-grid" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
