# ==========================================
# 저장소 루트 .gitignore
# 저장소 루트: E:\GameProjects\ProjectOne\  (모노레포)
#   - Unity 프로젝트: ProjectOne\   → 무시 규칙은 ProjectOne\.gitignore 가 전담
#   - 서버:          Server\       → 아래 Server 규칙이 담당
# ==========================================

# ------------------------------------------
# [Server] IDE / 빌드 산출물 (커밋 불필요)
# ------------------------------------------
Server/**/.vs/
Server/**/bin/
Server/**/obj/
Server/**/*.suo
Server/**/*.user

# ------------------------------------------
# OS 부산물 (전체 경로 공통)
# ------------------------------------------
# Excel 임시 잠금 파일
~$*.xlsx
~$*.xls
.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ------------------------------------------
# Claude Code 로컬 설정
# ------------------------------------------
.claude/settings.local.json
